{
  "name": "liang-wentao-portfolio",
  "author": "Liang Wentao",
  "description": "Liang Wentao portfolio site",
  "website": "https://hiwentao.com/zh-cn/watch",
  "repository": "https://github.com/wentao-tab/public-portfolio-site",
  "license": "(MIT AND AGPL-3.0-only)",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "node scripts/assemble-site.mjs && node scripts/preview-site.mjs",
    "start": "node scripts/preview-site.mjs",
    "build": "node scripts/assemble-site.mjs && node scripts/check-published-site.mjs",
    "site:notes": "node scripts/check-site-workflow.mjs",
    "site:branch": "node scripts/check-site-workflow.mjs --branch",
    "site:check": "node scripts/check-published-site.mjs",
    "site:build": "npm run build",
    "site:verify": "npm run build",
    "site:prepublish": "npm run site:branch && npm run site:verify",
    "preview": "node scripts/preview-site.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "6.0.2",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "astro": "6.4.4",
    "sass": "^1.79.4",
    "sharp": "^0.34.5",
    "three": "0.185.1",
    "typescript": "^5.6.2"
  }
}
