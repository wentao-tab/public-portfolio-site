---
import { books2026 } from "../data/books";

const shelfBooks = books2026.map((book, index) => ({ ...book, no: index + 1 }));
---

<main class="reading-shelf" data-complete-shelf tabindex="0">
  <header class="shelf-topbar">
    <a class="shelf-brand" href="/" aria-label="返回首页">
      <strong>WENTAO</strong><span>/ 我的书单</span>
    </a>
    <div class="shelf-topbar__meta"><b>{shelfBooks.length}</b> VOLUMES</div>
    <a class="shelf-home" href="/">返回首页</a>
  </header>

  <section class="shelf-stage" aria-label="梁文韬的 2026 年阅读书架">
    <div class="shelf-stage__eyebrow">
      <span>我的书单</span><i></i><span>2026 READING SHELF</span>
    </div>
    <div class="shelf-stage__count">{String(shelfBooks.length).padStart(2, "0")} VOLUMES<br />01 CONTINUOUS SHELF</div>

    <div class="shelf-canvas" data-shelf-canvas></div>

    <aside class="book-inspector" aria-live="polite">
      <div class="book-inspector__counter"><span data-book-current>01</span><i></i><span>{String(shelfBooks.length).padStart(2, "0")}</span></div>
      <h1 data-book-title>窄门</h1>
      <p class="book-inspector__author" data-book-author>2026 阅读记录</p>
      <p class="book-inspector__note" data-book-note></p>
      <button class="book-inspector__action" type="button" data-inspect-book>抽出这本</button>
    </aside>

    <button class="shelf-arrow shelf-arrow--prev" type="button" data-shelf-prev aria-label="上一本">←</button>
    <button class="shelf-arrow shelf-arrow--next" type="button" data-shelf-next aria-label="下一本">→</button>

    <div class="shelf-ticks" data-shelf-ticks aria-label="书目进度"></div>
    <p class="shelf-hint">拖拽 · 滚轮 · 方向键浏览，点击书脊抽出或放回</p>
  </section>
</main>

<script define:vars={{ shelfBooks }}>
  import { initCompleteShelf } from "../scripts/complete-shelf";

  const root = document.querySelector("[data-complete-shelf]");
  if (root instanceof HTMLElement) initCompleteShelf(root, shelfBooks);
</script>

<style is:global>
  :root {
    background: #1b1b1b;
  }

  body {
    margin: 0;
    background: #1b1b1b;
  }

  .reading-shelf {
    min-height: 100vh;
    color: #1d1a18;
    background: #1b1b1b;
    font-family: "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
    outline: none;
  }

  .shelf-topbar {
    height: 64px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 22px;
    color: #f8f5ef;
    background: #1b1b1b;
    letter-spacing: 0;
  }

  .shelf-brand {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .shelf-brand strong {
    font-size: 23px;
    font-weight: 900;
  }

  .shelf-brand span {
    color: #999895;
    font-size: 15px;
    font-weight: 700;
  }

  .shelf-topbar__meta {
    margin-left: auto;
    color: #aaa8a4;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  .shelf-topbar__meta b {
    color: #f6f2e8;
  }

  .shelf-home {
    padding: 10px 16px;
    border-radius: 999px;
    color: #202217;
    background: #c8fb35;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    transition: transform 180ms ease, background 180ms ease;
  }

  .shelf-home:hover {
    background: #dcff70;
    transform: translateY(-1px);
  }

  .shelf-stage {
    position: relative;
    min-height: calc(100vh - 64px);
    overflow: hidden;
    border: 12px solid #1b1b1b;
    border-radius: 0 0 18px 18px;
    box-sizing: border-box;
    background-color: #f8f3e9;
    background-image: radial-gradient(rgba(73, 56, 35, 0.13) 0.8px, transparent 0.8px);
    background-size: 8px 8px;
  }

  .shelf-stage::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 90px rgba(104, 73, 39, 0.08);
  }

  .shelf-stage__eyebrow,
  .shelf-stage__count {
    position: absolute;
    z-index: 4;
    top: 48px;
    color: #64615d;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  .shelf-stage__eyebrow {
    left: 64px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .shelf-stage__eyebrow i {
    width: 44px;
    height: 1px;
    background: #8c8780;
  }

  .shelf-stage__count {
    right: 68px;
    color: #8a857e;
    text-align: right;
    font-size: 11px;
    line-height: 1.55;
  }

  .shelf-canvas {
    position: absolute;
    z-index: 1;
    inset: 0;
  }

  .shelf-viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
  }

  .shelf-viewport:active {
    cursor: grabbing;
  }

  .shelf-ambience {
    position: absolute;
    left: 38%;
    bottom: 22%;
    width: min(62vw, 1100px);
    height: min(42vw, 650px);
    transform: translateX(-18%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(155, 130, 90, 0.23), rgba(155, 130, 90, 0) 68%);
    filter: blur(12px);
    pointer-events: none;
  }

  .shelf-book-track {
    position: absolute;
    z-index: 3;
    bottom: clamp(154px, 18vh, 190px);
    left: 0;
    display: flex;
    align-items: flex-end;
    height: min(60vh, 600px);
    padding: 0 58px;
    will-change: transform;
    transition: transform 720ms cubic-bezier(0.22, 0.86, 0.32, 1);
  }

  .shelf-book {
    --book-width: clamp(31px, 2.1vw, 52px);
    --book-height: clamp(290px, 36vh, 435px);
    position: relative;
    z-index: 1;
    flex: 0 0 var(--book-width);
    width: var(--book-width);
    height: var(--book-height);
    margin-right: clamp(2px, 0.22vw, 5px);
    padding: 0;
    border: 0;
    border-radius: 5px 4px 3px 3px;
    background: transparent;
    cursor: pointer;
    transform: translateY(0);
    transition: width 660ms cubic-bezier(0.22, 0.86, 0.32, 1), height 660ms cubic-bezier(0.22, 0.86, 0.32, 1), transform 660ms cubic-bezier(0.22, 0.86, 0.32, 1), filter 250ms ease;
  }

  .shelf-book:focus-visible {
    outline: 3px solid #1c1b19;
    outline-offset: 5px;
  }

  .shelf-book:not(.is-selected):hover {
    filter: brightness(1.08);
  }

  .shelf-book__body {
    position: absolute;
    inset: 0;
    display: block;
    overflow: visible;
    border: 1px solid rgba(39, 32, 23, 0.16);
    border-right: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.18), transparent 15%, transparent 78%, rgba(0, 0, 0, 0.12)), linear-gradient(180deg, color-mix(in srgb, var(--book-light) 75%, white), var(--book-tone));
    box-shadow: 7px 11px 13px rgba(48, 30, 16, 0.2), inset 1px 0 rgba(255, 255, 255, 0.65);
  }

  .shelf-book__body::before {
    content: "";
    position: absolute;
    inset: 10px 5px 10px 5px;
    border: 1px solid rgba(255, 255, 255, 0.33);
    border-radius: 2px;
    pointer-events: none;
  }

  .shelf-book__pages {
    position: absolute;
    top: 4px;
    right: -10px;
    width: 10px;
    height: calc(100% - 8px);
    border-radius: 0 3px 3px 0;
    background: repeating-linear-gradient(0deg, #d2c5a1 0 1px, #f9f2da 1px 3px);
    box-shadow: 3px 2px 3px rgba(50, 34, 18, 0.2);
  }

  .shelf-book__spine,
  .shelf-book__cover {
    position: absolute;
    inset: 0;
  }

  .shelf-book__spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 13px 5px 12px;
    box-sizing: border-box;
    color: #24211e;
    transition: opacity 300ms ease;
  }

  .shelf-book__serial,
  .shelf-book__year {
    color: rgba(30, 26, 21, 0.55);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    writing-mode: vertical-rl;
  }

  .shelf-book__spine-title {
    max-height: 72%;
    overflow: hidden;
    color: #26211e;
    font-family: "Songti SC", STSong, SimSun, serif;
    font-size: clamp(14px, 1vw, 20px);
    font-weight: 700;
    line-height: 1.22;
    text-align: center;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .shelf-book__cover {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 10px;
    padding: clamp(24px, 3vw, 45px);
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .shelf-book__cover-no,
  .shelf-book__cover-year {
    color: rgba(28, 25, 22, 0.58);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .shelf-book__cover-title {
    width: 100%;
    margin-top: auto;
    margin-bottom: auto;
    color: #211d1a;
    font-family: "Songti SC", STSong, SimSun, serif;
    font-size: clamp(25px, 3.1vw, 58px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .shelf-book__cover-meta {
    color: rgba(28, 25, 22, 0.64);
    font-size: 13px;
    line-height: 1.45;
  }

  .shelf-book__cover-year {
    align-self: center;
  }

  .shelf-book.is-selected {
    --book-width: clamp(260px, 19vw, 370px);
    --book-height: clamp(390px, 54vh, 610px);
    z-index: 6;
    transform: translateY(-29px);
  }

  .shelf-book.is-selected .shelf-book__body {
    border-radius: 7px 5px 5px 6px;
    box-shadow: 18px 24px 34px rgba(47, 30, 15, 0.29), inset 2px 0 rgba(255, 255, 255, 0.62);
  }

  .shelf-book.is-selected .shelf-book__spine {
    opacity: 0;
  }

  .shelf-book.is-selected .shelf-book__cover {
    opacity: 1;
  }

  .shelf-book.is-extracted {
    transform: translateY(clamp(-128px, -13vh, -86px));
  }

  .shelf-book.is-extracted .shelf-book__body {
    box-shadow: 25px 40px 48px rgba(47, 30, 15, 0.36), inset 2px 0 rgba(255, 255, 255, 0.62);
  }

  .shelf-wood {
    position: absolute;
    z-index: 2;
    right: -8vw;
    bottom: clamp(48px, 6vh, 72px);
    left: -8vw;
    height: clamp(106px, 13vh, 156px);
    pointer-events: none;
  }

  .shelf-wood__top {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 28px;
    border-top: 1px solid rgba(255, 239, 192, 0.65);
    border-bottom: 1px solid rgba(73, 37, 17, 0.35);
    background: linear-gradient(180deg, #f8d997 0%, #c88442 52%, #79411f 100%);
    box-shadow: 0 -6px 18px rgba(86, 53, 22, 0.2), inset 0 5px 10px rgba(255, 250, 220, 0.58);
  }

  .shelf-wood__lip {
    position: absolute;
    top: 27px;
    right: 0;
    left: 0;
    height: 19px;
    border-top: 2px solid rgba(255, 233, 182, 0.62);
    border-bottom: 3px solid #5f2e17;
    background: linear-gradient(#955026, #562715);
    box-shadow: inset 0 -4px 0 rgba(30, 10, 4, 0.46);
  }

  .shelf-wood__face {
    position: absolute;
    top: 46px;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid rgba(238, 159, 89, 0.55);
    background: linear-gradient(180deg, #5a2914 0%, #351509 46%, #1a0904 100%);
    box-shadow: inset 0 10px 16px rgba(253, 163, 83, 0.1), inset 0 -8px 0 rgba(0, 0, 0, 0.35);
  }

  .shelf-wood__rail {
    position: absolute;
    right: 0;
    bottom: 10px;
    left: 0;
    height: 4px;
    background: rgba(229, 166, 103, 0.28);
    box-shadow: 0 -3px 0 rgba(0, 0, 0, 0.28);
  }

  .book-inspector {
    position: absolute;
    z-index: 5;
    bottom: clamp(186px, 21vh, 245px);
    left: clamp(34px, 5vw, 104px);
    width: min(30vw, 470px);
    padding: 28px 34px 30px;
    box-sizing: border-box;
    background: linear-gradient(90deg, rgba(250, 246, 236, 0.94), rgba(250, 246, 236, 0.76));
    box-shadow: 26px 0 35px rgba(135, 104, 62, 0.06);
  }

  .book-inspector__counter {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #827b72;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.4px;
  }

  .book-inspector__counter i {
    width: 58px;
    height: 1px;
    background: #9b948a;
  }

  .book-inspector h1 {
    max-width: 100%;
    margin: 20px 0 8px;
    color: #201c19;
    font-family: "Songti SC", STSong, SimSun, serif;
    font-size: clamp(42px, 5.2vw, 94px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .book-inspector__author {
    margin: 0 0 20px;
    color: #756d65;
    font-family: Georgia, "Songti SC", serif;
    font-size: 15px;
    font-style: italic;
  }

  .book-inspector__note {
    min-height: 45px;
    margin: 0 0 25px;
    color: #66615b;
    font-size: 15px;
    line-height: 1.65;
  }

  .book-inspector__action {
    padding: 0 0 9px;
    border: 0;
    border-bottom: 2px solid #26211e;
    color: #27221e;
    background: transparent;
    cursor: pointer;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.65px;
    text-transform: uppercase;
  }

  .book-inspector__action::after {
    content: " ↗";
    margin-left: 9px;
  }

  .book-inspector__action:hover {
    color: #875822;
    border-color: #875822;
  }

  .shelf-arrow {
    position: absolute;
    z-index: 7;
    top: 52%;
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    border: 1px solid rgba(72, 61, 47, 0.16);
    border-radius: 50%;
    color: #5d554d;
    background: rgba(255, 252, 244, 0.72);
    box-shadow: 0 5px 13px rgba(77, 59, 35, 0.07);
    cursor: pointer;
    font-size: 23px;
    transition: background 180ms ease, transform 180ms ease;
  }

  .shelf-arrow:hover {
    color: #1e1c1a;
    background: #fffdf8;
    transform: scale(1.06);
  }

  .shelf-arrow--prev {
    left: 48px;
  }

  .shelf-arrow--next {
    right: 48px;
  }

  .shelf-ticks {
    position: absolute;
    z-index: 7;
    right: 9%;
    bottom: 18px;
    left: 9%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    height: 24px;
  }

  .shelf-ticks::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 1px;
    background: rgba(80, 66, 47, 0.2);
  }

  .shelf-tick {
    position: relative;
    z-index: 1;
    width: 3px;
    height: 12px;
    padding: 0;
    border: 0;
    background: #a7a098;
    cursor: pointer;
    transition: height 220ms ease, background 220ms ease;
  }

  .shelf-tick.is-current {
    height: 25px;
    background: #2a2622;
  }

  .shelf-hint {
    position: absolute;
    z-index: 7;
    right: 36px;
    bottom: 18px;
    margin: 0;
    color: #817b73;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .shelf-topbar {
      height: 58px;
      padding: 0 15px;
    }

    .shelf-topbar__meta {
      display: none;
    }

    .shelf-stage {
      min-height: calc(100vh - 58px);
      border-width: 7px;
      border-radius: 0;
    }

    .shelf-stage__eyebrow {
      top: 25px;
      left: 24px;
      gap: 10px;
      font-size: 10px;
      letter-spacing: 1.3px;
    }

    .shelf-stage__eyebrow i {
      width: 22px;
    }

    .shelf-stage__count {
      top: 25px;
      right: 24px;
      font-size: 9px;
    }

    .shelf-book-track {
      bottom: 142px;
      height: 54vh;
      padding: 0 22px;
    }

    .shelf-book {
      --book-width: 25px;
      --book-height: min(39vh, 330px);
      margin-right: 2px;
    }

    .shelf-book.is-selected {
      --book-width: min(66vw, 298px);
      --book-height: min(48vh, 460px);
      transform: translateY(-15px);
    }

    .shelf-book.is-extracted {
      transform: translateY(-64px);
    }

    .book-inspector {
      right: 20px;
      bottom: 139px;
      left: 20px;
      width: auto;
      padding: 14px 17px;
      background: rgba(250, 246, 236, 0.83);
    }

    .book-inspector h1 {
      margin: 10px 0 5px;
      font-size: clamp(34px, 11vw, 58px);
    }

    .book-inspector__note,
    .book-inspector__author {
      display: none;
    }

    .shelf-arrow {
      top: auto;
      bottom: 102px;
      width: 46px;
      height: 46px;
      font-size: 18px;
    }

    .shelf-arrow--prev {
      left: 16px;
    }

    .shelf-arrow--next {
      right: 16px;
    }

    .shelf-hint {
      display: none;
    }

    .shelf-ticks {
      right: 20px;
      bottom: 15px;
      left: 20px;
      gap: 8px;
    }
  }
</style>
