---
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { books2026, bookStats } from "../data/books";
import { booksTdk, pageDescription, pageTag } from "../data/content";

const shelfBooks = books2026.map((book, index) => ({
	...book,
	slug: `${String(book.no).padStart(2, '0')}-${book.title}`,
	height: 260 + ((index * 41) % 92),
	width: 58 + ((index * 17) % 30),
	lean: ((index % 5) - 2) * 1.4,
}));
---

<BlogPostLayout
	title={booksTdk.title || ''}
	description={booksTdk.description || ''}
	keywords={booksTdk.keywords || ''}
>
	<div class="post">
		<main class="post-wrapper books-page">
			<SectionHeader
				tag={pageTag.books}
				description={pageDescription.books}
			>
				我的书单
			</SectionHeader>

			<section class="complete-shelf border-top" data-book-shelf>
				<div class="shelf-summary" aria-label="2026 年阅读概览">
					<div>
						<span>YEAR</span>
						<strong>{bookStats.year}</strong>
					</div>
					<div>
						<span>BOOKS</span>
						<strong>{bookStats.total}</strong>
					</div>
					<div>
						<span>REREAD</span>
						<strong>{bookStats.reread}</strong>
					</div>
					<div>
						<span>NOTES</span>
						<strong>{bookStats.notes}</strong>
					</div>
				</div>

				<div class="shelf-shell" data-total={`${bookStats.total} VOLUMES`}>
					<button type="button" class="shelf-nav shelf-nav-prev" aria-label="上一册">←</button>
					<button type="button" class="shelf-nav shelf-nav-next" aria-label="下一册">→</button>
					<div class="shelf-viewport" aria-label={`2026 年书架，共 ${bookStats.total} 本书`}>
						<div class="shelf-floor" aria-hidden="true"></div>
						<div class="shelf-track">
							{shelfBooks.map((book) => (
								<button
									type="button"
									class:list={['shelf-book', `tone-${book.tone}`]}
									data-book-index={book.no - 1}
									style={`--book-h:${book.height}px;--book-w:${book.width}px;--book-lean:${book.lean}deg;`}
									aria-label={`查看 ${book.title}`}
								>
									<span class="book-spine-top">#{String(book.no).padStart(2, '0')}</span>
									<span class="book-spine-title">{book.title}</span>
									{book.mark && <span class="book-spine-mark">{book.mark}</span>}
								</button>
							))}
						</div>
					</div>

					<div class="shelf-caption" aria-live="polite">
						<p class="shelf-count">
							<span data-active-count>01</span>
							<i></i>
							<span>{String(bookStats.total).padStart(2, '0')}</span>
						</p>
						<h2 data-active-title>{shelfBooks[0]?.title}</h2>
						<p data-active-note>{shelfBooks[0]?.note}</p>
						<div class="shelf-actions">
							<button type="button" class="inspect-book">抽出这本</button>
						</div>
						<p class="shelf-hint">拖拽 · 滚轮 · 方向键浏览，点击书脊查看</p>
					</div>
				</div>

				<nav class="shelf-index" aria-label="书架位置">
					{shelfBooks.map((book) => (
						<button
							type="button"
							data-dot-index={book.no - 1}
							aria-label={`跳转到 ${book.title}`}
							aria-current={book.no === 1 ? 'true' : undefined}
						>
							<span></span>
						</button>
					))}
				</nav>

				<aside class="book-detail" aria-hidden="true">
					<div class="detail-backdrop" data-close-detail></div>
					<article class="detail-card" role="dialog" aria-modal="true" aria-label="书籍详情" tabindex="-1">
						<button type="button" class="detail-close" data-close-detail>返回书架</button>
						<div class="detail-cover" data-detail-cover>
							<div class="detail-cover-top">
								<span>2026 READING</span>
								<span data-detail-no>01</span>
							</div>
							<h2 data-detail-cover-title>{shelfBooks[0]?.title}</h2>
							<div class="detail-cover-bottom">
								<span>LIANG WENTAO</span>
								<span>BOOK LIST</span>
							</div>
						</div>
						<div class="detail-copy">
							<p class="detail-kicker">SELECTED VOLUME</p>
							<h3 data-detail-title>{shelfBooks[0]?.title}</h3>
							<p class="detail-mark" data-detail-mark>{shelfBooks[0]?.mark}</p>
							<p class="detail-note" data-detail-note>{shelfBooks[0]?.note}</p>
							<dl>
								<div>
									<dt>编号</dt>
									<dd data-detail-index>01 / {String(bookStats.total).padStart(2, '0')}</dd>
								</div>
								<div>
									<dt>状态</dt>
									<dd>2026 书单记录</dd>
								</div>
							</dl>
						</div>
					</article>
				</aside>
			</section>
		</main>
	</div>
</BlogPostLayout>

<script is:inline type="application/json" id="books-shelf-data" set:html={JSON.stringify(shelfBooks)} />

<script is:inline>
	const root = document.querySelector('[data-book-shelf]');
	const dataNode = document.getElementById('books-shelf-data');

	if (root && dataNode?.textContent) {
		const books = JSON.parse(dataNode.textContent);
		const track = root.querySelector('.shelf-track');
		const viewport = root.querySelector('.shelf-viewport');
		const bookButtons = Array.from(root.querySelectorAll('.shelf-book'));
		const dots = Array.from(root.querySelectorAll('[data-dot-index]'));
		const prevButton = root.querySelector('.shelf-nav-prev');
		const nextButton = root.querySelector('.shelf-nav-next');
		const inspectButton = root.querySelector('.inspect-book');
		const detail = root.querySelector('.book-detail');
		const detailCard = root.querySelector('.detail-card');
		const closeButtons = root.querySelectorAll('[data-close-detail]');
		const activeCount = root.querySelector('[data-active-count]');
		const activeTitle = root.querySelector('[data-active-title]');
		const activeNote = root.querySelector('[data-active-note]');
		let active = 0;
		let dragStart = 0;
		let dragDelta = 0;
		let isDragging = false;

		const selectors = {
			detailNo: root.querySelector('[data-detail-no]'),
			detailCoverTitle: root.querySelector('[data-detail-cover-title]'),
			detailTitle: root.querySelector('[data-detail-title]'),
			detailMark: root.querySelector('[data-detail-mark]'),
			detailNote: root.querySelector('[data-detail-note]'),
			detailIndex: root.querySelector('[data-detail-index]'),
			detailCover: root.querySelector('[data-detail-cover]'),
		};

		function two(value) {
			return String(value).padStart(2, '0');
		}

		function setActive(next) {
			active = Math.max(0, Math.min(books.length - 1, next));
			const book = books[active];
			activeCount.textContent = two(book.no);
			activeTitle.textContent = book.title;
			activeNote.textContent = book.note || '待读完后补一条短想法。';

			bookButtons.forEach((button, index) => {
				button.classList.toggle('is-active', index === active);
				button.setAttribute('aria-current', index === active ? 'true' : 'false');
			});
			dots.forEach((dot, index) => {
				dot.classList.toggle('is-active', index === active);
				dot.setAttribute('aria-current', index === active ? 'true' : 'false');
			});
			prevButton.disabled = active === 0;
			nextButton.disabled = active === books.length - 1;
			updateDetail(book);

			requestAnimationFrame(() => {
				const activeButton = bookButtons[active];
				const maxOffset = Math.max(0, (track?.scrollWidth || 0) - (viewport?.clientWidth || 0));
				const rawOffset = activeButton
					? activeButton.offsetLeft - ((viewport?.clientWidth || 0) - activeButton.offsetWidth) / 2
					: active * 78;
				const offset = Math.max(0, Math.min(maxOffset, rawOffset));
				track?.style.setProperty('--shelf-x', `${offset}px`);
			});
		}

		function updateDetail(book) {
			selectors.detailNo.textContent = two(book.no);
			selectors.detailCoverTitle.textContent = book.title;
			selectors.detailTitle.textContent = book.title;
			selectors.detailMark.textContent = book.mark || '梁文韬 2026 阅读记录';
			selectors.detailNote.textContent = book.note || '待读完后补一条短想法。';
			selectors.detailIndex.textContent = `${two(book.no)} / ${two(books.length)}`;
			selectors.detailCover.className = `detail-cover tone-${book.tone}`;
		}

		function openDetail(index = active) {
			setActive(index);
			detail?.classList.add('is-open');
			detail?.setAttribute('aria-hidden', 'false');
			document.documentElement.classList.add('is-book-detail-open');
			window.setTimeout(() => detailCard?.focus?.(), 80);
		}

		function closeDetail() {
			detail?.classList.remove('is-open');
			detail?.setAttribute('aria-hidden', 'true');
			document.documentElement.classList.remove('is-book-detail-open');
		}

		prevButton?.addEventListener('click', () => setActive(active - 1));
		nextButton?.addEventListener('click', () => setActive(active + 1));
		inspectButton?.addEventListener('click', () => openDetail(active));
		closeButtons.forEach((button) => button.addEventListener('click', closeDetail));

		bookButtons.forEach((button, index) => {
			button.addEventListener('click', () => openDetail(index));
			button.addEventListener('mouseenter', () => setActive(index));
		});

		dots.forEach((dot) => {
			dot.addEventListener('click', () => setActive(Number(dot.dataset.dotIndex)));
		});

		root.addEventListener('wheel', (event) => {
			if (detail?.classList.contains('is-open')) return;
			event.preventDefault();
			const direction = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
			setActive(active + (direction > 0 ? 1 : -1));
		}, { passive: false });

		root.addEventListener('pointerdown', (event) => {
			if (detail?.classList.contains('is-open') || event.target.closest('.book-detail')) return;
			isDragging = true;
			dragStart = event.clientX;
			dragDelta = 0;
			root.classList.add('is-dragging');
		});

		window.addEventListener('pointermove', (event) => {
			if (!isDragging) return;
			dragDelta = event.clientX - dragStart;
		});

		window.addEventListener('pointerup', () => {
			if (!isDragging) return;
			root.classList.remove('is-dragging');
			isDragging = false;
			if (Math.abs(dragDelta) > 46) {
				setActive(active + (dragDelta < 0 ? 1 : -1));
			}
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				closeDetail();
				return;
			}
			if (detail?.classList.contains('is-open')) return;
			if (event.key === 'ArrowLeft') setActive(active - 1);
			if (event.key === 'ArrowRight') setActive(active + 1);
			if (event.key === 'Enter') openDetail(active);
		});

		setActive(0);
	}
</script>

<style lang="scss">
	.books-page {
		display: flex;
		flex-direction: column;
		width: min(1480px, calc(100vw - 48px));
		max-width: none;
		margin-left: calc((100% - min(1480px, calc(100vw - 48px))) / 2);
	}

	.complete-shelf {
		margin-top: clamp(28px, 4vw, 54px);
		padding: 8px;
		border-radius: 18px;
		background: #1f1f1f;
		box-shadow: 0 34px 120px rgba(20, 18, 15, 0.16);
	}

	.complete-shelf.border-top {
		border-top: 0 !important;
	}

	.shelf-summary {
		display: none;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		width: min(980px, 100%);
		margin: 0 auto clamp(28px, 4vw, 54px);
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--border);

		div {
			min-height: 92px;
			padding: 20px 24px;
			background: rgba(255, 255, 255, 0.72);
		}

		span {
			color: var(--color-400);
			font-family: var(--font-type);
			font-size: 0.74rem;
		}

		strong {
			display: block;
			margin-top: 12px;
			color: var(--color-100);
			font-family: var(--font-type);
			font-size: 2rem;
			line-height: 1;
		}
	}

	.shelf-shell {
		position: relative;
		display: block;
		height: min(790px, calc(100vh - 170px));
		min-height: 680px;
		overflow: hidden;
		border: 1px solid rgba(37, 35, 31, 0.18);
		border-radius: 14px;
		background:
			radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.4), transparent 44%),
			linear-gradient(180deg, rgba(247, 242, 232, 0.92), rgba(226, 217, 202, 0.92));
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.32);

		&::before {
			content: "THE COMPLETE SHELF  ——  AN INTERACTIVE 3D LIBRARY";
			position: absolute;
			z-index: 4;
			top: 30px;
			left: clamp(24px, 3.6vw, 58px);
			color: rgba(37, 35, 31, 0.74);
			font-family: var(--font-type);
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.22em;
		}

		&::after {
			content: attr(data-total) "\A 01 CONTINUOUS SHELF";
			position: absolute;
			z-index: 4;
			top: 30px;
			right: clamp(24px, 3.6vw, 58px);
			color: rgba(37, 35, 31, 0.54);
			font-family: var(--font-type);
			font-size: 0.66rem;
			font-weight: 700;
			letter-spacing: 0.2em;
			line-height: 1.5;
			text-align: right;
			white-space: pre;
		}
	}

	.shelf-viewport {
		position: absolute;
		z-index: 2;
		inset: 72px 0 70px 30%;
		display: flex;
		align-items: flex-end;
		min-height: 0;
		margin: 0;
		overflow: hidden;
		perspective: 1200px;
		cursor: grab;
		touch-action: none;
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 94%, transparent);

		.is-dragging & {
			cursor: grabbing;
		}
	}

	.shelf-floor {
		position: absolute;
		right: -4%;
		bottom: 48px;
		left: -44%;
		height: 96px;
		border-radius: 0;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(53, 34, 18, 0.2) 42%, rgba(45, 26, 14, 0.42)),
			#9a714e;
		box-shadow:
			0 22px 40px rgba(58, 39, 21, 0.24),
			inset 0 2px 0 rgba(255, 255, 255, 0.44),
			inset 0 -18px 24px rgba(35, 22, 12, 0.28);
		transform: perspective(500px) rotateX(18deg);
		transform-origin: top center;
	}

	.shelf-track {
		--shelf-x: 0px;
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		gap: 8px;
		min-width: max-content;
		height: 100%;
		padding: 0 62vw 96px 16vw;
		transform: translate3d(calc(0px - var(--shelf-x)), 0, 0) rotateX(0.01deg);
		transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);
		transform-style: preserve-3d;
	}

	.shelf-book {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: var(--book-w);
		height: var(--book-h);
		padding: 16px 10px 15px;
		border: 1px solid rgba(0, 0, 0, 0.18);
		border-radius: 3px 9px 9px 3px;
		color: #171717;
		background: #eee5d6;
		box-shadow:
			inset 12px 0 18px rgba(255, 255, 255, 0.22),
			inset -12px 0 16px rgba(47, 31, 17, 0.08),
			10px 0 0 rgba(0, 0, 0, 0.14),
			20px 28px 34px rgba(35, 24, 12, 0.2);
		transform:
			translateZ(0)
			rotateY(-20deg)
			rotateZ(var(--book-lean));
		transform-origin: bottom center;
		transition:
			width 520ms cubic-bezier(0.22, 1, 0.36, 1),
			height 520ms cubic-bezier(0.22, 1, 0.36, 1),
			padding 520ms cubic-bezier(0.22, 1, 0.36, 1),
			border-radius 520ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
			filter 260ms ease,
			box-shadow 260ms ease;

		&::before {
			content: "";
			position: absolute;
			top: 10px;
			bottom: 10px;
			left: 8px;
			width: 2px;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.46);
		}

		&::after {
			content: "";
			position: absolute;
			top: 8px;
			right: -9px;
			bottom: 6px;
			width: 10px;
			border-radius: 0 7px 7px 0;
			background:
				repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.24) 0 1px, rgba(0, 0, 0, 0.08) 1px 2px),
				linear-gradient(90deg, rgba(0, 0, 0, 0.24), rgba(255, 255, 255, 0.18)),
				inherit;
			pointer-events: none;
			transform: skewY(3deg);
		}

		&:hover {
			z-index: 5;
			filter: saturate(1.08);
			box-shadow:
				inset 12px 0 18px rgba(255, 255, 255, 0.24),
				inset -12px 0 16px rgba(47, 31, 17, 0.09),
				12px 0 0 rgba(0, 0, 0, 0.15),
				24px 32px 54px rgba(35, 24, 12, 0.26);
			transform:
				translate3d(0, -38px, 112px)
				rotateY(-26deg)
				rotateZ(0deg);
		}

		&.is-active {
			z-index: 8;
			width: clamp(320px, 25vw, 440px);
			height: clamp(480px, 58vh, 620px);
			padding: clamp(28px, 3vw, 42px);
			border-radius: 4px 12px 12px 4px;
			filter: saturate(1.04);
			box-shadow:
				inset 16px 0 22px rgba(255, 255, 255, 0.24),
				inset -18px 0 22px rgba(47, 31, 17, 0.1),
				14px 0 0 rgba(0, 0, 0, 0.16),
				34px 42px 80px rgba(35, 24, 12, 0.3);
			transform:
				translate3d(0, -50px, 150px)
				rotateY(-13deg)
				rotateZ(0deg);
		}
	}

	.book-spine-top,
	.book-spine-mark {
		position: relative;
		z-index: 1;
		color: rgba(0, 0, 0, 0.58);
		font-family: var(--font-type);
		font-size: 0.68rem;
		line-height: 1;
		writing-mode: vertical-rl;
	}

	.book-spine-title {
		position: relative;
		z-index: 1;
		align-self: center;
		max-height: 180px;
		color: rgba(0, 0, 0, 0.86);
		font-family: 'Huiwen-mincho', var(--font-body);
		font-size: 1.08rem;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: 0;
		writing-mode: vertical-rl;
	}

	.shelf-book.is-active {
		.book-spine-top,
		.book-spine-mark {
			writing-mode: horizontal-tb;
		}

		.book-spine-top {
			letter-spacing: 0.18em;
		}

		.book-spine-title {
			align-self: flex-start;
			max-width: 7em;
			max-height: none;
			margin-top: clamp(20px, 4vh, 52px);
			font-family: "Iowan Old Style", Georgia, "Songti SC", serif;
			font-size: clamp(2.4rem, 3.6vw, 4.7rem);
			font-weight: 650;
			line-height: 0.92;
			letter-spacing: -0.02em;
			text-align: left;
			writing-mode: horizontal-tb;
		}

		.book-spine-mark {
			margin-top: auto;
			letter-spacing: 0.14em;
		}
	}

	.shelf-caption {
		position: absolute;
		z-index: 6;
		bottom: clamp(142px, 20vh, 214px);
		left: clamp(30px, 5vw, 88px);
		display: flex;
		flex-direction: column;
		justify-content: center;
		width: min(430px, 35vw);
		min-width: 0;
		padding: 0;
		pointer-events: none;

		&::before {
			content: "";
			position: absolute;
			z-index: -1;
			inset: -42px -80px -36px -90px;
			background: linear-gradient(90deg, rgba(238, 232, 219, 0.96), rgba(238, 232, 219, 0.72) 62%, rgba(238, 232, 219, 0));
		}

		h2 {
			margin: 0;
			color: #25231f;
			font-family: "Iowan Old Style", Georgia, "Songti SC", serif;
			font-size: clamp(3.2rem, 5.3vw, 6.2rem);
			font-weight: 540;
			line-height: 0.92;
			letter-spacing: -0.03em;
			overflow-wrap: anywhere;
		}

		p {
			max-width: 620px;
			margin: 26px 0 0;
			color: var(--color-300);
			font-size: 1rem;
			line-height: 1.75;
		}
	}

	.shelf-count {
		display: flex;
		gap: 12px;
		align-items: center;
		margin-bottom: 16px !important;
		color: var(--color-400) !important;
		font-family: var(--font-type);
		font-size: 0.82rem !important;
		line-height: 1 !important;

		i {
			width: 48px;
			height: 1px;
			background: var(--color-600);
		}
	}

	.shelf-actions {
		display: flex;
		gap: 10px;
		align-items: center;
		margin-top: 28px;
		pointer-events: auto;
	}

	.shelf-nav,
	.inspect-book,
	.detail-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.74);
		color: var(--color-100);
		font-weight: 700;
		transition:
