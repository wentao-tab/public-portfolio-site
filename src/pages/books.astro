---
import BaseLayout from "../layouts/BaseLayout.astro";
import { books2026 } from "../data/books";
---

<BaseLayout title="我的书单" description="2026 年阅读书单，只留下书名，慢慢补上下一本。">
  <main class="books-page">
    <section class="books-intro" aria-labelledby="books-title">
      <p class="books-kicker">READING LIST · 2026</p>
      <h1 id="books-title">我的书单</h1>
      <p class="books-lede">2026 年，读过的书和正在读的书。</p>
    </section>

    <section class="books-list-section" aria-labelledby="books-list-title">
      <div class="books-list-heading">
        <h2 id="books-list-title">书名</h2>
        <span>{books2026.length} 本</span>
      </div>
      <ol class="books-list">
        {books2026.map((book, index) => (
          <li class="books-list-item">
            <span class="books-list-number">{String(index + 1).padStart(2, "0")}</span>
            <span class="books-list-title">{book.title}</span>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #fff;
  }

  .books-page {
    min-height: calc(100vh - 84px);
    color: #202020;
  }

  .books-intro {
    max-width: 920px;
    margin: 0 auto;
    padding: clamp(5rem, 10vw, 8.5rem) 1.25rem 4rem;
    border-bottom: 1px solid #e7e7e7;
  }

  .books-kicker {
    margin: 0 0 1.5rem;
    color: #858585;
    font: 0.72rem/1.2 "Courier New", monospace;
    letter-spacing: 0.18em;
  }

  .books-intro h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: 0;
  }

  .books-lede {
    max-width: 28rem;
    margin: 1.6rem 0 0;
    color: #777;
    font-size: 1rem;
    line-height: 1.8;
  }

  .books-list-section {
    max-width: 920px;
    margin: 0 auto;
    padding: 3.8rem 1.25rem 7rem;
  }

  .books-list-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid #202020;
  }

  .books-list-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .books-list-heading span {
    color: #888;
    font: 0.75rem "Courier New", monospace;
    letter-spacing: 0.08em;
  }

  .books-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .books-list-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.05rem 0;
    border-bottom: 1px solid #e9e9e9;
  }

  .books-list-number {
    color: #a0a0a0;
    font: 0.75rem "Courier New", monospace;
  }

  .books-list-title {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.35;
  }

  .books-list-item:hover .books-list-title {
    color: #9a691f;
  }

  @media (max-width: 600px) {
    .books-intro {
      padding-top: 4.5rem;
      padding-bottom: 2.75rem;
    }

    .books-list-section {
      padding-top: 2.5rem;
    }

    .books-list-item {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.85rem;
      padding: 0.9rem 0;
    }
  }
</style>
