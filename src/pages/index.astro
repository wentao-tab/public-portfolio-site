---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from "../components/SectionHeader.astro";
import {pageTag, pageDescription,homeTdk} from '../data/content';
import { withBase } from '../utils/paths';
---

<BaseLayout
title={homeTdk.title  || ''}
description ={homeTdk.description  || ''}
keywords = {homeTdk.keywords  || ''}
>
	<div class="section hero">
		<div class="container">
			<SectionHeader
				tag={pageTag.index}
				description={pageDescription.index}>
    			设计&读书思考
			</SectionHeader>
			<section class="home-project border-top">
				<div class="home-project-list">
					<a class="home-project-card" href={withBase('/project/fengcheng-vpp/')} aria-label="打开凤城全域虚拟电厂智慧驾驶舱项目">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-fengcheng-vpp.jpg')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">NEW PROJECT</div>
							<h2>凤城全域虚拟电厂智慧驾驶舱</h2>
							<p>面向全域能源调度、负荷聚合与运行态势感知的智慧驾驶舱入口。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-learning-fourth-read/')} aria-label="打开受持。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-learning-fourth-read.webp')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>受持。</h2>
							<p>真正懂，不是会复述，而是能在事上用出来。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0619/')} aria-label="打开不住好人相。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>不住好人相。</h2>
							<p>善意要保留，但不要把“我是好人”变成自己的任务。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0610/')} aria-label="打开我读金刚经感悟 6/10">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>我读金刚经感悟 6/10</h2>
							<p>应无所住而生其心。做一件该做的小事，做完就放下。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0611/')} aria-label="打开凡所有相，皆是虚妄。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>凡所有相，皆是虚妄。</h2>
							<p>别太相信眼前这一刻的感觉很真。看见相，但不马上下结论。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0612/')} aria-label="打开过去心不可得，现在心不可得，未来心不可得。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>过去心不可得，现在心不可得，未来心不可得。</h2>
							<p>不要把精力浪费在抓不住的心上。下一步是什么？</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0614/')} aria-label="打开不取法，不取非法。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>不取法，不取非法。</h2>
							<p>不要被规则绑住，也不要用“反规则”绑住自己。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0615/')} aria-label="打开无我相。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>无我相。</h2>
							<p>少一点“我在证明什么”，事情会轻很多。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0616/')} aria-label="打开无所得。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>无所得。</h2>
							<p>真正有价值的成长，常常不是多拿到什么，而是少被什么牵着走。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
					<a class="home-project-card reading-card" href={withBase('/notes/jingangjing-0617/')} aria-label="打开若以恒河沙等身命布施。">
						<div class="project-visual" aria-hidden="true">
							<img src={withBase('/assets/cover/cover-jingangjing-0610.png')} alt="" loading="lazy" />
						</div>
						<div class="home-project-copy">
							<div class="project-eyebrow">READING NOTE</div>
							<h2>若以恒河沙等身命布施。</h2>
							<p>数量再大，也不等于心真正自由。</p>
						</div>
						<span class="home-project-arrow">↗</span>
					</a>
				</div>
			</section>
		</div>
	</div>

</BaseLayout>

<style lang="scss">
	.home-project {
		max-width: 1080px;
		margin: 18px auto 0;
		padding-top: 28px;
	}

	.home-project-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		align-items: stretch;
	}

	.home-project-card {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		gap: 20px;
		min-height: 100%;
		padding: 20px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.52)),
			var(--color-999);
		box-shadow: 0 18px 52px rgba(0, 0, 0, 0.05);
		text-decoration: none;
		transform-style: preserve-3d;
		transition:
			transform 0.28s ease,
			box-shadow 0.28s ease,
			border-color 0.28s ease,
			background 0.28s ease;

		&::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 1;
			border-radius: inherit;
			background: linear-gradient(120deg, transparent 18%, rgba(255, 255, 255, 0.56) 42%, transparent 66%);
			opacity: 0;
			pointer-events: none;
			transform: translateX(-48%);
			transition: opacity 0.28s ease, transform 0.7s ease;
		}

		&:hover {
			transform: translateY(-8px) rotateX(1.2deg);
			border-color: rgba(73, 154, 213, 0.55);
			background:
				linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(238, 249, 246, 0.72)),
				var(--color-999);
			box-shadow: 0 34px 84px rgba(27, 72, 92, 0.14);
			text-decoration: none;
		}

		&:hover::before {
			opacity: 1;
			transform: translateX(48%);
		}

		&:hover .project-visual img {
			transform: scale(1.045);
		}

		&:hover .home-project-arrow {
			color: var(--color-blue);
			transform: translate(4px, -4px);
		}
	}

	.reading-card {
		.project-visual {
			background: #f5efe3;
		}

		&:hover {
			border-color: rgba(184, 138, 55, 0.56);
			box-shadow: 0 34px 84px rgba(120, 87, 34, 0.14);
		}

		&:hover .home-project-arrow {
			color: #9b7a35;
		}
	}

	.project-visual {
		position: relative;
		z-index: 2;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 6px;
		background: #eef8f4;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.42);

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.7s ease;
		}
	}

	.home-project-copy {
		position: relative;
		z-index: 2;

		h2 {
			margin: 8px 0 12px;
			color: var(--color-100);
			font-size: 1.6rem;
			line-height: 1.28;
			text-align: left;
		}

		p {
			max-width: 24em;
			margin: 0;
			color: var(--color-300);
			font-size: 0.95rem;
			line-height: 1.7;
			text-align: left;
		}
	}

	.project-eyebrow {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		padding: 0 12px;
		border-radius: 999px;
		background: var(--color-yellow);
		color: var(--color-100);
		font-family: var(--font-type);
		font-size: 0.78rem;
		line-height: 1;
	}

	.home-project-arrow {
		position: absolute;
		z-index: 2;
		right: 20px;
		bottom: 16px;
		color: var(--color-400);
		font-size: 1.5rem;
		line-height: 1;
		transition: color 0.24s ease, transform 0.24s ease;
	}

	@media(max-width: 767px) {
		.home-project-list {
			grid-template-columns: 1fr;
		}

		.home-project-card {
			gap: 20px;
			padding: 18px;
		}

		.project-visual {
			min-height: 176px;
		}

		.home-project-arrow {
			top: 18px;
			right: 18px;
			bottom: auto;
		}

		.home-project-copy h2 {
			font-size: 1.45rem;
		}
	}
</style>
