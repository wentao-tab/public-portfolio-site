---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from "../components/SectionHeader.astro";
import {pageTag, pageDescription,homeTdk} from '../data/content';
import { withBase } from '../utils/paths';
---

<BaseLayout
title={homeTdk.title  || ''}
description ={homeTdk.description  || ''}
keywords = {homeTdk.keywords  || ''}
>
	<div class="section hero">
		<div class="container">
			<SectionHeader
				tag={pageTag.index}
				description={pageDescription.index}>
    			设计&读书思考
			</SectionHeader>
			<section class="home-project border-top">
				<a class="home-project-card" href={withBase('/project/fengcheng-vpp/')} aria-label="打开凤城全域虚拟电厂智慧驾驶舱项目">
					<div class="project-visual" aria-hidden="true">
						<img src={withBase('/assets/cover/cover-fengcheng-vpp.jpg')} alt="" loading="lazy" />
					</div>
					<div class="home-project-copy">
						<div class="project-eyebrow">NEW PROJECT</div>
						<h2>凤城全域虚拟电厂智慧驾驶舱</h2>
						<p>面向全域能源调度、负荷聚合与运行态势感知的智慧驾驶舱入口。</p>
					</div>
					<span class="home-project-arrow">↗</span>
				</a>
			</section>
		</div>
	</div>

</BaseLayout>

<style lang="scss">
	.home-project {
		max-width: 760px;
		margin: 18px auto 0;
		padding-top: 28px;
	}

	.home-project-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
		gap: 28px;
		align-items: center;
		padding: 22px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.52)),
			var(--color-999);
		box-shadow: 0 18px 52px rgba(0, 0, 0, 0.05);
		text-decoration: none;
		transform-style: preserve-3d;
		transition:
			transform 0.28s ease,
			box-shadow 0.28s ease,
			border-color 0.28s ease,
			background 0.28s ease;

		&::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 1;
			border-radius: inherit;
			background: linear-gradient(120deg, transparent 18%, rgba(255, 255, 255, 0.56) 42%, transparent 66%);
			opacity: 0;
			pointer-events: none;
			transform: translateX(-48%);
			transition: opacity 0.28s ease, transform 0.7s ease;
		}

		&:hover {
			transform: translateY(-8px) rotateX(1.2deg);
			border-color: rgba(73, 154, 213, 0.55);
			background:
				linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(238, 249, 246, 0.72)),
				var(--color-999);
			box-shadow: 0 34px 84px rgba(27, 72, 92, 0.14);
			text-decoration: none;
		}

		&:hover::before {
			opacity: 1;
			transform: translateX(48%);
		}

		&:hover .project-visual img {
			transform: scale(1.045);
		}

		&:hover .home-project-arrow {
			color: var(--color-blue);
			transform: translate(4px, -4px);
		}
	}

	.project-visual {
		position: relative;
		z-index: 2;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 6px;
		background: #eef8f4;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.42);

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.7s ease;
		}
	}

	.home-project-copy {
		position: relative;
		z-index: 2;

		h2 {
			margin: 8px 0 12px;
			color: var(--color-100);
			font-size: 1.8rem;
			line-height: 1.28;
			text-align: left;
		}

		p {
			max-width: 24em;
			margin: 0;
			color: var(--color-300);
			font-size: 0.95rem;
			line-height: 1.7;
			text-align: left;
		}
	}

	.project-eyebrow {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		padding: 0 12px;
		border-radius: 999px;
		background: var(--color-yellow);
		color: var(--color-100);
		font-family: var(--font-type);
		font-size: 0.78rem;
		line-height: 1;
	}

	.home-project-arrow {
		position: absolute;
		z-index: 2;
		right: 20px;
		bottom: 16px;
		color: var(--color-400);
		font-size: 1.5rem;
		line-height: 1;
		transition: color 0.24s ease, transform 0.24s ease;
	}

	@media(max-width: 767px) {
		.home-project-card {
			grid-template-columns: 1fr;
			gap: 20px;
			padding: 18px;
		}

		.project-visual {
			min-height: 176px;
		}

		.home-project-arrow {
			top: 18px;
			right: 18px;
			bottom: auto;
		}

		.home-project-copy h2 {
			font-size: 1.45rem;
		}
	}
</style>
