---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import myPortrait from '../assets/portrait.jpg';
import { withBase } from '../utils/paths';

const projectEntries = [
	{
		label: 'NEW / PROJECT',
		title: '凤城全域虚拟电厂智慧驾驶舱',
		desc: '面向全域能源调度、负荷聚合与运行态势感知的智慧驾驶舱入口。',
		date: '2026.06.08',
		href: withBase('/project/fengcheng-vpp/'),
		cover: withBase('/assets/cover/cover-fengcheng-vpp.jpg'),
	},
	{
		label: 'AI / PRODUCT',
		title: '文汐 AI 提示词广场',
		desc: 'AI 提示词收集、发布与复用工具，把好用的表达留下来。',
		date: '2026.06.08',
		href: 'https://wentao-tab.github.io/Wenxi-ai-clone/',
		cover: withBase('/assets/cover/cover-wenxi-ai-clone.jpg'),
		external: true,
	},
];

const toolEntries = [
	{
		label: 'JOURNAL TOOL',
		title: '日常日记',
		desc: '把当天的片段、情绪和想法留下来，慢慢看见自己的生活。',
		href: 'https://dailly-journal.vercel.app/?v=8708d45',
		visual: 'journal',
		external: true,
	},
	{
		label: 'TRAVEL TOOL',
		title: '出发吧！从南京',
		desc: '从南京出发的旅行手账地图，比较目的地、交通方式和门到门耗时。',
		href: withBase('/tools/nanjing-travel-map/'),
		cover: withBase('/assets/cover/cover-nanjing-route-atlas.png'),
	},
	{
		label: 'AI TOOL',
		title: '提示词图鉴',
		desc: '按场景浏览、搜索和复用 AI 提示词模板。',
		href: 'https://wentao-tab.github.io/Wenxi-ai-clone/',
		cover: withBase('/assets/cover/cover-wenxi-prompt-atlas.png'),
		external: true,
	},
	{
		label: 'SLEEP TOOL',
		title: '鸟鸣睡眠舱',
		desc: '只放南京奥体鸟鸣，用来学习、工作和睡前放松。',
		href: withBase('/sleep/'),
		cover: withBase('/assets/cover/cover-linlai-tool.png'),
	},
	{
		label: 'SUTRA TOOL',
		title: '金刚经配图版',
		desc: '三十二品图文卡片、白话提示、诵读音频和水墨插图。',
		href: withBase('/jingangjing/'),
		cover: withBase('/assets/cover/cover-jingangjing-tool.png'),
	},
	{
		label: 'SUTRA CHAT',
		title: '应作如是',
		desc: '围绕金刚经阅读与思考的对话入口，整理问题和当下的理解。',
		href: withBase('/sutra-chat/'),
		cover: withBase('/assets/cover/cover-yingzuorushi-chat.webp'),
	},
];

const experienceEntries = [
	{ date: '2019. 6-至今', org: '南京文思海辉信息技术有限公司', role: 'UI/UX' },
	{ date: '2016. 8-2019. 6', org: '江苏千米网络科技股份有限公司', role: 'UI' },
	{ date: '2016. 01-2016. 08', org: '北京智鸟科技有限公司', role: 'UI' },
];

const pageDescription = '梁文韬的个人入口：产品设计、阅读思考、AI 实验和一些正在使用的小工具。';
---

<BaseLayout
	title="梁文韬｜个人索引"
	description={pageDescription}
	keywords="梁文韬,个人网站,产品设计,读书,AI工具,小工具"
>
	<main class="index-page">
		<section class="home-stage" aria-labelledby="index-title">
			<div class="home-viewport">
			<div class="home-brand">
				<span>WENTAO</span>
				<small>PERSONAL INDEX / 2026</small>
			</div>

			<div class="sticker-board" aria-label="个人入口贴纸">
				<a class="sticker sticker-generated sticker-notebook" href={withBase('/jingangjing/')} data-home-text="慢慢读书">
					<img src={withBase('/assets/home-stickers/home-notebook-v1.png')} alt="金刚经配图版" />
					<span>金刚经配图版</span>
				</a>
				<a class="sticker sticker-generated sticker-compass" href={withBase('/tools/nanjing-travel-map/')} data-home-text="在城市里散步">
					<img src={withBase('/assets/home-stickers/home-compass-v1.png')} alt="出发吧！从南京" />
					<span>出发吧！从南京</span>
				</a>
				<a class="sticker sticker-generated sticker-coffee" href={withBase('/sleep/')} data-home-text="慢慢喝一杯咖啡">
					<img src={withBase('/assets/home-stickers/home-coffee-v1.png')} alt="鸟鸣睡眠舱" />
					<span>鸟鸣睡眠舱</span>
				</a>
				<a class="sticker sticker-generated sticker-paper-plane" href={withBase('/project/fengcheng-vpp/')} data-home-text="把复杂的事做成工具">
					<img src={withBase('/assets/home-stickers/home-paper-plane-v1.png')} alt="凤城全域虚拟电厂智慧驾驶舱" />
					<span>凤城项目</span>
				</a>
				<a class="sticker sticker-generated sticker-prompt-cards" href={withBase('/books/')} data-home-text="整理读过的东西">
					<img src={withBase('/assets/home-stickers/home-prompt-cards-v1.png')} alt="我的书单" />
					<span>我的书单</span>
				</a>
				<a class="sticker sticker-generated sticker-listening" href="https://dailly-journal.vercel.app/?v=8708d45" target="_blank" rel="noreferrer" data-home-text="听一会儿日常">
					<img src={withBase('/assets/home-stickers/home-listening-branch-v1.png')} alt="日常日记" />
					<span>日常日记</span>
				</a>
				<a class="sticker sticker-word sticker-word-yellow" href={withBase('/essays/life-manual/')} data-home-text="读一读我的人生说明书">
					<strong>LIFE<br />MANUAL</strong>
					<span>文韬的人生说明书</span>
				</a>
				<a class="sticker sticker-word sticker-word-black" href="https://wentao-tab.github.io/Wenxi-ai-clone/" target="_blank" rel="noreferrer" data-home-text="试试新的想法">
					<strong>AI<br />LAB</strong>
					<span>提示词图鉴</span>
				</a>
				<a class="sticker sticker-generated sticker-sutra" href={withBase('/sutra-chat/')} data-home-text="把经文放回今天">
					<img src={withBase('/assets/home-stickers/home-sutra-paper-v1.png')} alt="应作如是" />
					<span>应作如是</span>
				</a>
			</div>

			<div class="home-center">
				<div class="home-callout is-visible" data-home-callout aria-live="polite">点一点贴纸，看看我在做什么</div>
				<div class="home-dialogue">
					<div class="home-avatar"><Image src={myPortrait} alt="梁文韬" width={94} height={94} /></div>
					<div class="home-bubble" aria-hidden="true">
						<div class="home-dots"><i></i><i></i><i></i></div>
					</div>
				</div>
				<h1 id="index-title" class="home-line" data-home-line>
					<span>梁文韬正在</span><span class="home-thinking-word" data-home-thinking-word>设计、读书、做工具</span><span>。</span>
				</h1>
			</div>

			<div class="home-note" role="note">
				<span>WELCOME / 2026</span>
				<p>点一点贴纸，看看我最近在设计、读书和制作什么。</p>
				<i aria-hidden="true"></i>
			</div>

			<a class="home-scroll" href="#home-intro" aria-label="向下查看自我介绍">
				<span>↓</span>
			</a>
			</div>

			<div class="home-mark" data-home-mark aria-hidden="true">
				<div class="home-mark-plate" data-home-mark-plate></div>
				<svg viewBox="0 0 300 160" focusable="false" shape-rendering="geometricPrecision">
					<path class="home-mark-layer" data-home-mark-layer data-lag="0" stroke="#61BB46" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
					<path class="home-mark-layer" data-home-mark-layer data-lag="0.08" stroke="#FDB827" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
					<path class="home-mark-layer" data-home-mark-layer data-lag="0.16" stroke="#F5821F" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
					<path class="home-mark-layer" data-home-mark-layer data-lag="0.24" stroke="#E03A3E" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
					<path class="home-mark-layer" data-home-mark-layer data-lag="0.32" stroke="#963D97" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
					<path class="home-mark-layer" data-home-mark-layer data-lag="0.40" stroke="#009DDC" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
					<path class="home-mark-layer" data-home-mark-layer data-lag="0.52" stroke="#242624" d="M20 26H88M54 26V134M108 134L140 24L172 134M119 96H161M230 24C201 24 190 45 190 79C190 113 201 134 230 134C259 134 270 113 270 79C270 45 259 24 230 24Z" pathLength="1" stroke-width="11.2" stroke-dasharray="1" stroke-dashoffset="1" />
				</svg>
			</div>
		</section>

		<section class="home-intro" id="home-intro" data-home-intro aria-labelledby="home-intro-title">
			<div class="home-intro-inner">
				<div class="home-intro-identity">
					<div class="home-intro-name">梁文韬</div>
				</div>

				<div class="home-intro-chat" id="home-intro-title">
					<p class="home-intro-bubble" data-home-intro-step="0">嗨，我是文韬。</p>
					<p class="home-intro-bubble" data-home-intro-step="1">我是一名产品设计师，喜欢用像素、系统和代码，把复杂的事做成真正能用的工具。</p>
					<p class="home-intro-bubble" data-home-intro-step="2">我在做产品，也在读书、写作，研究 AI 如何进入日常。</p>
					<p class="home-intro-bubble" data-home-intro-step="3">我把工作里的经验、读过的书和正在做的实验，放进这个个人索引里。</p>
					<p class="home-intro-bubble home-intro-bubble-small" data-home-intro-step="4">现在，我在独立做一些有用的小东西，也慢慢把生活过清楚。</p>
				</div>
			</div>
		</section>

		<div class="index-archive">
		<section class="index-section" data-index-section="project" aria-labelledby="project-heading">
			<header class="section-heading">
				<h2 id="project-heading">Projects</h2>
			</header>
			<div class="index-grid project-list">
				{projectEntries.map((entry) => (
					<a class="index-card project-card" href={entry.href} target={entry.external ? '_blank' : undefined} rel={entry.external ? 'noreferrer' : undefined}>
						<div class="project-thumb">
							<img src={entry.cover} alt="" loading="lazy" />
						</div>
						<div class="project-card-copy">
							<h3>{entry.title}</h3>
							<p>{entry.desc}</p>
						</div>
						<time class="project-card-date">{entry.date}</time>
					</a>
				))}
			</div>
		</section>

		<section class="index-section" data-index-section="tool" aria-labelledby="tool-heading">
			<header class="section-heading">
				<h2 id="tool-heading">Tools</h2>
			</header>
			<div class="index-grid tool-list" data-tool-stack>
				{toolEntries.map((entry, index) => (
					<a class="index-card tool-card" data-tool-card style={`--tool-index: ${index}; --tool-count: ${toolEntries.length}`} href={entry.href} target={entry.external ? '_blank' : undefined} rel={entry.external ? 'noreferrer' : undefined}>
						<div class="tool-thumb">
							{entry.cover ? <img src={entry.cover} alt="" loading="lazy" /> : <span>日记</span>}
						</div>
						<div class="tool-card-copy">
							<h3>{entry.title}</h3>
							<p>{entry.desc}</p>
						</div>
						<span class="tool-card-action">OPEN ↗</span>
					</a>
				))}
			</div>
		</section>

	<section class="index-section experience-section" data-index-section="experience" aria-labelledby="experience-heading">
		<header class="section-heading">
			<h2 id="experience-heading">工作经验描述</h2>
		</header>
		<div class="experience-list" data-experience-stack>
			{experienceEntries.map((entry, index) => (
				<div class="experience-card" data-experience-card style={`--experience-index: ${index}; --experience-count: ${experienceEntries.length}`}>
					<time>{entry.date}</time>
					<div class="experience-copy">
						<div>{entry.org}</div>
					</div>
					<div class="experience-role">{entry.role}</div>
				</div>
			))}
		</div>
		</section>
		</div>
	</main>
</BaseLayout>

<script>
	const thinkingWord = document.querySelector('[data-home-thinking-word]') as HTMLElement | null;
	const homeCallout = document.querySelector('[data-home-callout]') as HTMLElement | null;
	const defaultThinkingWord = thinkingWord?.textContent?.trim() || '设计、读书、做工具';
	const defaultHomeCallout = '点一点贴纸，看看我在做什么';
	const stickers = [...document.querySelectorAll('.sticker')] as HTMLAnchorElement[];
	const homeStage = document.querySelector('.home-stage') as HTMLElement | null;
	const homePage = document.querySelector('.index-page') as HTMLElement | null;
	const homeCenter = document.querySelector('.home-center') as HTMLElement | null;
	const homeMark = document.querySelector('[data-home-mark]') as HTMLElement | null;
	const homeMarkLayers = [...document.querySelectorAll('[data-home-mark-layer]')] as SVGPathElement[];
	const homeIntroChat = document.querySelector('.home-intro-chat') as HTMLElement | null;
	const homeIntroSteps = [...document.querySelectorAll('[data-home-intro-step]')] as HTMLElement[];
	const homeNote = document.querySelector('.home-note') as HTMLElement | null;
	const homeBrand = document.querySelector('.home-brand') as HTMLElement | null;
	const homeScroll = document.querySelector('.home-scroll') as HTMLElement | null;
	const homeIntroSendLine = 0.88;
	const homeIntroSendStep = 130;
	const homeIntroSendSpan = 190;
	const thinkingWords = [
		defaultThinkingWord,
		'思考一些问题',
		'去城市里散步',
		'慢慢喝一杯咖啡',
		'把复杂的事做成工具',
		'听一会儿日常',
		'试试新的想法',
		'把经文放回今天',
	];
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let thinkingIndex = 0;
	let thinkingTimer = 0;
	let thinkingToken = 0;
	let thinkingPaused = false;
	let waitingForTop = false;
	let homeScrollFrame = 0;
	const stickerDrifts = [
		[-0.45, -0.22],
		[-0.08, -0.32],
		[0.45, -0.18],
		[-0.45, 0.16],
		[0.36, -0.24],
		[0.4, 0.24],
		[-0.32, 0.28],
		[0.42, 0.28],
		[-0.27, 0.3],
	];

	const clamp = (value: number, min = 0, max = 1) => Math.min(Math.max(value, min), max);
	const easeOut = (value: number) => 1 - Math.pow(1 - clamp(value), 3);
	const smoothStep = (value: number) => {
		const normalized = clamp(value);
		return normalized * normalized * (3 - 2 * normalized);
	};
	const easeOvershoot = (value: number, pull = 1.2) => {
		const normalized = clamp(value) - 1;
		return 1 + (pull + 1) * normalized ** 3 + pull * normalized ** 2;
	};
	const getScrollTop = () => document.body.scrollHeight > document.body.clientHeight
		? document.body.scrollTop
		: (document.scrollingElement?.scrollTop || window.scrollY);
	const setScrollTop = (value: number) => {
		if (document.body.scrollHeight > document.body.clientHeight) document.body.scrollTo(0, value);
		else window.scrollTo(0, value);
	};

	if (homeScroll) {
		homeScroll.addEventListener('click', (event) => {
			const target = homeIntroChat || document.querySelector('#home-intro');
			if (!target) return;
			event.preventDefault();
			const start = getScrollTop();
			const targetTop = target.getBoundingClientRect().top + start;
			const destination = homeIntroChat
				? targetTop - window.innerHeight * homeIntroSendLine + homeIntroSendStep + homeIntroSendSpan + 36
				: targetTop - 12;
			if (reducedMotion.matches) {
				setScrollTop(destination);
				return;
			}

			const distance = destination - start;
			const duration = Math.min(Math.max(Math.abs(distance) / 260 * 1000, 1200), 4200);
			const startedAt = performance.now();
			const glide = (now: number) => {
				const progress = clamp((now - startedAt) / duration);
				const eased = progress < 0.5
					? 4 * progress * progress * progress
					: 1 - Math.pow(-2 * progress + 2, 3) / 2;
				setScrollTop(start + distance * eased);
				if (progress < 1) window.requestAnimationFrame(glide);
			};
			window.requestAnimationFrame(glide);
		});
	}

	const updateHomeScroll = () => {
		homeScrollFrame = 0;
		if (!homeStage) return;

		const stageTop = homeStage.getBoundingClientRect().top + getScrollTop();
		const travel = Math.max(homeStage.offsetHeight - window.innerHeight, 1);
		const progress = clamp((getScrollTop() - stageTop) / travel);
		const eased = easeOut(progress);
		homeStage.style.setProperty('--home-progress', String(progress));
		const schemeProgress = smoothStep((progress - 0.8) / 0.2);
		homePage?.style.setProperty('--home-scheme-progress', String(schemeProgress));

		stickers.forEach((sticker, index) => {
			const [x, y] = stickerDrifts[index] || [0, 0];
			sticker.style.setProperty('--home-drift-x', `${x * window.innerWidth * eased}px`);
			sticker.style.setProperty('--home-drift-y', `${y * window.innerHeight * eased}px`);
			sticker.style.setProperty('--home-fade', String(clamp(progress / 0.18)));
		});

		if (homeCenter) {
			const centerExit = smoothStep(progress / 0.3);
			homeCenter.style.setProperty('--home-center-lift', `${eased * window.innerHeight * 0.9}px`);
			homeCenter.style.opacity = String(1 - centerExit);
		}
		if (homeCallout) homeCallout.style.opacity = String(1 - clamp(progress / 0.14));

		if (homeBrand) homeBrand.style.opacity = String(1 - clamp(progress / 0.12));
		if (homeNote) {
			homeNote.style.setProperty('--home-note-x', `${eased * window.innerWidth * 0.24}px`);
			homeNote.style.setProperty('--home-note-y', `${eased * window.innerHeight * 0.24}px`);
			homeNote.style.opacity = String(1 - clamp(progress / 0.2));
		}
		if (homeScroll) {
			homeScroll.style.opacity = String(1 - clamp(progress / 0.06));
			homeScroll.style.pointerEvents = progress > 0.06 ? 'none' : 'auto';
		}
		if (homeMark) {
			const markProgress = progress;
			const strokeWidth = 11.2 + (20 - 11.2) * easeOvershoot((markProgress - 0.4) / 0.6);
			const markShrink = 1 - (1 - 0.18) * smoothStep((markProgress - 0.75) / 0.25);
			homeMarkLayers.forEach((layer) => {
				const lag = Number(layer.dataset.lag || 0);
				const layerDrawn = smoothStep((markProgress - lag) / (1 - lag));
				layer.style.strokeDashoffset = String(1 - layerDrawn);
				layer.setAttribute('stroke-width', String(strokeWidth));
			});
			/* The original does not replace the mark with a second logo. The plate
				and the traced mark share one scale value; the plate only fades in over
				the same settling band, then both release from sticky together. */
			homeMark.style.opacity = '1';
			homeMark.style.setProperty('--home-mark-scale', String(markShrink));
			homeMark.style.setProperty('--home-mark-plate-opacity', String(smoothStep((markProgress - 0.75) / 0.25)));
		}
		if (homeIntroChat) {
			const scrollTop = getScrollTop();
			const chatTop = homeIntroChat.getBoundingClientRect().top + scrollTop;
			const sendOrigin = chatTop - window.innerHeight * homeIntroSendLine;
			homeIntroSteps.forEach((step, index) => {
				const due = sendOrigin + index * homeIntroSendStep;
				const sendProgress = easeOut((scrollTop - due) / homeIntroSendSpan);
				step.style.setProperty('--home-intro-send', String(sendProgress));
			});
		}
	};

	const scheduleHomeScroll = () => {
		if (homeScrollFrame) return;
		homeScrollFrame = window.requestAnimationFrame(updateHomeScroll);
	};

	window.addEventListener('scroll', scheduleHomeScroll, { passive: true });
	document.body.addEventListener('scroll', scheduleHomeScroll, { passive: true });
	window.addEventListener('resize', scheduleHomeScroll);

	const clearThinkingTimer = () => {
		if (thinkingTimer) window.clearTimeout(thinkingTimer);
		thinkingTimer = 0;
	};

	const animateThinkingWord = (nextText: string) => {
		if (!thinkingWord || !nextText || thinkingWord.textContent === nextText) return;
		const token = ++thinkingToken;

		if (reducedMotion.matches) {
			thinkingWord.textContent = nextText;
			thinkingWord.classList.remove('is-washing');
			return;
		}

		let text = thinkingWord.textContent || '';
		const step = Math.max(22, 280 / Math.max(text.length, 1));
		const backspace = () => {
			if (token !== thinkingToken) return;
			text = text.slice(0, -1);
			thinkingWord.textContent = text;
			if (text.length) {
				window.setTimeout(backspace, step);
				return;
			}

			thinkingWord.textContent = nextText;
			thinkingWord.classList.remove('is-washing');
			void thinkingWord.offsetWidth;
			thinkingWord.classList.add('is-washing');
			window.setTimeout(() => {
				if (token === thinkingToken) thinkingWord.classList.remove('is-washing');
			}, 790);
		};

		window.setTimeout(backspace, step);
	};

	const scheduleThinking = (delay = 1600) => {
		clearThinkingTimer();
		if (!thinkingWord || thinkingPaused || !atTop()) return;
		thinkingTimer = window.setTimeout(() => {
			if (thinkingPaused || !atTop()) {
				waitingForTop = true;
				return;
			}
			thinkingIndex = (thinkingIndex + 1) % thinkingWords.length;
			animateThinkingWord(thinkingWords[thinkingIndex]);
			scheduleThinking(1600);
		}, delay);
	};

	const setHomeState = (text = defaultThinkingWord, callout = defaultHomeCallout) => {
		clearThinkingTimer();
		thinkingPaused = text !== defaultThinkingWord;
		animateThinkingWord(text);

		if (homeCallout && homeCallout.textContent !== callout) {
			homeCallout.textContent = callout;
			homeCallout.animate(
				[
					{ opacity: 0, transform: 'translateY(7px) rotate(-2deg)' },
					{ opacity: 1, transform: 'translateY(0) rotate(-2deg)' },
				],
				{ duration: 300, easing: 'ease-out' },
			);
		}

		if (!thinkingPaused) scheduleThinking(2400);
	};

	stickers.forEach((sticker) => {
		const label = sticker.querySelector(':scope > span')?.textContent?.trim() || '这个入口';
		const stickerLine = sticker.dataset.homeText || `打开${label}`;

		sticker.addEventListener('mouseenter', () => setHomeState(stickerLine, label));
		sticker.addEventListener('mouseleave', () => {
			if (!sticker.classList.contains('is-open')) setHomeState();
		});
		sticker.addEventListener('focus', () => setHomeState(stickerLine, label));
		sticker.addEventListener('blur', () => {
			if (!sticker.classList.contains('is-open')) setHomeState();
		});
		sticker.addEventListener('click', (event) => {
			if (sticker.classList.contains('is-open')) return;
			event.preventDefault();
			stickers.forEach((item) => item.classList.remove('is-open'));
			sticker.classList.add('is-open');
			setHomeState(stickerLine, label);
		});
	});

		document.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('.sticker')) return;
		stickers.forEach((sticker) => sticker.classList.remove('is-open'));
		setHomeState();
	});

	const atTop = () => getScrollTop() <= 0;
	window.addEventListener('scroll', () => {
		if (atTop() && waitingForTop) {
			waitingForTop = false;
			scheduleThinking(1600);
		}
	}, { passive: true });

	scheduleThinking();
	scheduleHomeScroll();

	const setupFoldStack = (stackSelector: string, cardSelector: string, waitingClass: string, depthVariable: string) => {
		const stack = document.querySelector(stackSelector) as HTMLElement | null;
		const cards = stack ? [...stack.querySelectorAll(cardSelector)] as HTMLElement[] : [];
		let frame = 0;
		let slots: Array<{ top: number; height: number }> = [];

		const measure = () => {
			if (!stack || !cards.length) return;
			const listTop = stack.getBoundingClientRect().top + getScrollTop();
			slots = cards.map((card) => ({
				top: listTop + card.offsetTop - stack.offsetTop,
				height: card.offsetHeight,
			}));
		};

		const update = () => {
			frame = 0;
			if (!stack || !cards.length || !slots.length) return;

			const stackBottom = 56;
			const scrollTop = getScrollTop();
			const scrollLine = scrollTop + window.innerHeight - stackBottom;
			const listTop = slots[0]?.top || 0;
			const listBottom = listTop + stack.offsetHeight;
			const stackIsActive = listTop < scrollLine && listBottom > scrollTop - stackBottom;
			let waitingDepth = 0;

			cards.forEach((card, index) => {
				const slot = slots[index];
				const waiting = stackIsActive && slot.top + slot.height > scrollLine;
				const depth = waiting ? Math.min(++waitingDepth, 3) : 0;
				card.style.setProperty(depthVariable, String(depth));
				card.classList.toggle(waitingClass, waiting);
			});
		};

		const schedule = () => {
			if (frame) return;
			frame = window.requestAnimationFrame(update);
		};

		if (stack && cards.length) {
			measure();
			update();
			window.addEventListener('resize', () => {
				measure();
				schedule();
			});
			window.addEventListener('scroll', schedule, { passive: true });
			document.body.addEventListener('scroll', schedule, { passive: true });
		}
	};

	setupFoldStack('[data-tool-stack]', '[data-tool-card]', 'is-tool-waiting', '--tool-depth');


</script>

