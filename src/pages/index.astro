---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from "../components/SectionHeader.astro";
import {pageTag, pageDescription,homeTdk} from '../data/content';
import { withBase } from '../utils/paths';
---

<BaseLayout
title={homeTdk.title  || ''}
description ={homeTdk.description  || ''}
keywords = {homeTdk.keywords  || ''}
>
	<div class="section hero">
		<div class="container">
			<SectionHeader
				tag={pageTag.index}
				description={pageDescription.index}>
    			设计&读书思考
			</SectionHeader>
			<section class="home-project border-top">
				<a class="home-project-card" href={withBase('/project/fengcheng-vpp/')} aria-label="打开凤城全域虚拟电厂智慧驾驶舱项目">
					<div class="project-visual" aria-hidden="true">
						<div class="visual-toolbar">
							<span></span>
							<span></span>
							<span></span>
						</div>
						<div class="visual-grid">
							<div class="visual-map">
								<div class="map-line map-line-a"></div>
								<div class="map-line map-line-b"></div>
								<div class="map-dot dot-a"></div>
								<div class="map-dot dot-b"></div>
								<div class="map-dot dot-c"></div>
							</div>
							<div class="visual-metrics">
								<div></div>
								<div></div>
								<div></div>
							</div>
							<div class="visual-chart">
								<span style="height: 48%"></span>
								<span style="height: 72%"></span>
								<span style="height: 38%"></span>
								<span style="height: 86%"></span>
								<span style="height: 58%"></span>
							</div>
						</div>
					</div>
					<div class="home-project-copy">
						<div class="project-eyebrow">NEW PROJECT</div>
						<h2>凤城全域虚拟电厂智慧驾驶舱</h2>
						<p>面向全域能源调度、负荷聚合与运行态势感知的智慧驾驶舱入口。</p>
					</div>
					<span class="home-project-arrow">↗</span>
				</a>
			</section>
		</div>
	</div>

</BaseLayout>

<style lang="scss">
	.home-project {
		max-width: 760px;
		margin: 18px auto 0;
		padding-top: 28px;
	}

	.home-project-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
		gap: 28px;
		align-items: center;
		padding: 22px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.52)),
			var(--color-999);
		box-shadow: 0 18px 52px rgba(0, 0, 0, 0.05);
		text-decoration: none;
		transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;

		&:hover {
			transform: translateY(-3px);
			border-color: var(--color-blue);
			box-shadow: 0 24px 64px rgba(0, 0, 0, 0.08);
			text-decoration: none;
		}
	}

	.project-visual {
		position: relative;
		min-height: 188px;
		overflow: hidden;
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 6px;
		background:
			linear-gradient(90deg, rgba(73, 154, 213, 0.12) 1px, transparent 1px),
			linear-gradient(0deg, rgba(73, 154, 213, 0.12) 1px, transparent 1px),
			linear-gradient(135deg, #edf8f4 0%, #f8fbff 48%, #dfeeff 100%);
		background-size: 24px 24px, 24px 24px, auto;
	}

	.visual-toolbar {
		display: flex;
		gap: 6px;
		align-items: center;
		height: 32px;
		padding: 0 14px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
		background: rgba(255, 255, 255, 0.68);

		span {
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: var(--color-green);

			&:nth-child(2) {
				background: var(--color-yellow);
			}

			&:nth-child(3) {
				background: var(--color-blue);
			}
		}
	}

	.visual-grid {
		display: grid;
		grid-template-columns: 1.25fr 0.85fr;
		grid-template-rows: 1fr 56px;
		gap: 12px;
		padding: 14px;
	}

	.visual-map,
	.visual-metrics,
	.visual-chart {
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.72);
	}

	.visual-map {
		position: relative;
		min-height: 86px;
		grid-row: span 2;
	}

	.map-line,
	.map-dot {
		position: absolute;
	}

	.map-line {
		height: 2px;
		border-radius: 999px;
		background: var(--color-blue);
		transform-origin: left center;
		opacity: 0.75;
	}

	.map-line-a {
		top: 46%;
		left: 18%;
		width: 58%;
		transform: rotate(-16deg);
	}

	.map-line-b {
		top: 58%;
		left: 24%;
		width: 48%;
		transform: rotate(24deg);
	}

	.map-dot {
		width: 12px;
		height: 12px;
		border: 2px solid var(--color-white);
		border-radius: 50%;
		background: var(--color-green);
		box-shadow: 0 6px 18px rgba(27, 196, 125, 0.35);
	}

	.dot-a {
		top: 34%;
		left: 18%;
	}

	.dot-b {
		top: 25%;
		right: 20%;
	}

	.dot-c {
		bottom: 18%;
		left: 56%;
	}

	.visual-metrics {
		display: grid;
		gap: 7px;
		padding: 10px;

		div {
			border-radius: 999px;
			background: linear-gradient(90deg, rgba(27, 196, 125, 0.7), rgba(73, 154, 213, 0.7));

			&:nth-child(2) {
				width: 78%;
			}

			&:nth-child(3) {
				width: 58%;
			}
		}
	}

	.visual-chart {
		display: flex;
		align-items: end;
		gap: 7px;
		padding: 10px;

		span {
			flex: 1;
			min-height: 10px;
			border-radius: 4px 4px 0 0;
			background: var(--color-blue);
			opacity: 0.78;
		}
	}

	.home-project-copy {
		h2 {
			margin: 8px 0 12px;
			color: var(--color-100);
			font-size: 1.8rem;
			line-height: 1.28;
			text-align: left;
		}

		p {
			max-width: 24em;
			margin: 0;
			color: var(--color-300);
			font-size: 0.95rem;
			line-height: 1.7;
			text-align: left;
		}
	}

	.project-eyebrow {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		padding: 0 12px;
		border-radius: 999px;
		background: var(--color-yellow);
		color: var(--color-100);
		font-family: var(--font-type);
		font-size: 0.78rem;
		line-height: 1;
	}

	.home-project-arrow {
		position: absolute;
		right: 20px;
		bottom: 16px;
		color: var(--color-400);
		font-size: 1.5rem;
		line-height: 1;
	}

	@media(max-width: 767px) {
		.home-project-card {
			grid-template-columns: 1fr;
			gap: 20px;
			padding: 18px;
		}

		.project-visual {
			min-height: 176px;
		}

		.home-project-arrow {
			top: 18px;
			right: 18px;
			bottom: auto;
		}

		.home-project-copy h2 {
			font-size: 1.45rem;
		}
	}
</style>
