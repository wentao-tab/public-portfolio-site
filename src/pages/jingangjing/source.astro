---
import MainHead from "../../components/MainHead.astro";
import diamondSutraData from "../../data/diamond-sutra.json";
import { withBase } from "../../utils/paths";

const meta = diamondSutraData.meta;
const title = "金刚般若波罗蜜经";
const byline = `${meta.dynasty ?? ""}${meta.translator ?? ""}译`;
const paragraphs = diamondSutraData.paragraphs.filter((item) => item.position >= 3 && item.position <= 128);
---

<html lang="zh-CN">
	<head>
		<MainHead
			title={`${title} · 原文阅读`}
			description="《金刚般若波罗蜜经》原文与白话翻译对照阅读。"
			keywords="金刚经,金刚般若波罗蜜经,原文阅读,白话翻译"
		/>
	</head>
	<body class="source-reader-body">
		<main class="source-reader">
			<header class="source-topbar">
				<a href={withBase("/jingangjing/")} aria-label="返回金刚经配图版">← 返回配图阅读</a>
				<span>原文阅读</span>
			</header>

			<section class="source-hero" aria-labelledby="source-title">
				<p class="source-mark">DIAMOND SUTRA · SOURCE TEXT</p>
				<h1 id="source-title">{title}</h1>
				<p class="source-byline">{byline}</p>
			</section>

			<article class="source-content" aria-label="金刚般若波罗蜜经原文与白话翻译">
				{paragraphs.map((paragraph) => {
					const translation = paragraph.translations?.find((item) => item.language === "zh-CN")?.translatedText ?? "";
					return (
						<section class="source-entry">
							<div class="original-block">
								<p>{paragraph.originalText}</p>
							</div>
							{translation && (
								<div class="translation-block">
									<p>{translation}</p>
								</div>
							)}
						</section>
					);
				})}
			</article>

			<footer class="source-footer">
				<a href={withBase("/jingangjing/")}>返回配图阅读</a>
			</footer>
		</main>
	</body>
</html>

<style lang="scss">
	:global(html),
	:global(body.source-reader-body) {
		margin: 0;
		min-width: 320px;
		background: #fbfaf7;
	}

	:global(body.source-reader-body) {
		color: #34302c;
		font-family: Iowan Old Style, Songti SC, "Noto Serif CJK SC", PingFang SC, serif;
	}

	.source-reader {
		min-height: 100vh;
		background:
			linear-gradient(90deg, rgba(116, 94, 58, 0.025) 1px, transparent 1px),
			linear-gradient(180deg, #fbfaf7 0%, #f7f3ec 100%);
		background-size: 36px 36px, auto;
	}

	.source-topbar {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 58px;
		padding: 0 max(20px, calc((100vw - 1180px) / 2));
		border-bottom: 1px solid rgba(161, 122, 64, 0.18);
		background: rgba(251, 250, 247, 0.9);
		backdrop-filter: blur(14px);

		a,
		span {
			color: rgba(52, 48, 44, 0.72);
			font-family: PingFang SC, sans-serif;
			font-size: 14px;
			font-weight: 700;
			text-decoration: none;
		}

		span {
			color: #a56b18;
		}
	}

	.source-hero {
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
		padding: 46px 0 48px;
		text-align: center;
	}

	.source-mark {
		margin: 0 0 14px;
		color: rgba(165, 107, 24, 0.72);
		font-family: Iowan Old Style, Georgia, serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.source-hero h1 {
		margin: 0;
		color: #2f2a26;
		font-size: 36px;
		line-height: 1.25;
		letter-spacing: 0;
	}

	.source-byline {
		margin: 34px 0 0;
		color: #b27616;
		font-size: 18px;
		font-weight: 700;
		text-align: right;
	}

	.source-content {
		display: grid;
		gap: 54px;
		width: min(1180px, calc(100% - 48px));
		margin: 0 auto;
		padding-bottom: 72px;
	}

	.source-entry {
		display: grid;
		gap: 28px;
	}

	.original-block {
		padding: 24px 28px;
		border-left: 3px solid rgba(183, 137, 59, 0.32);
		border-radius: 0 10px 10px 0;
		background: rgba(246, 241, 232, 0.76);
	}

	.original-block p,
	.translation-block p {
		margin: 0;
		letter-spacing: 0;
		white-space: pre-line;
	}

	.original-block p {
		color: rgba(52, 48, 44, 0.86);
		font-size: 28px;
		font-weight: 650;
		line-height: 2;
	}

	.translation-block {
		padding: 0 8px 0 18px;
	}

	.translation-block p {
		color: rgba(52, 48, 44, 0.84);
		font-size: 25px;
		line-height: 2.05;
	}

	.source-footer {
		display: flex;
		justify-content: center;
		padding: 0 24px 56px;

		a {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 42px;
			padding: 0 18px;
			border: 1px solid rgba(161, 122, 64, 0.22);
			border-radius: 999px;
			background: rgba(255, 252, 246, 0.86);
			color: #34302c;
			font-family: PingFang SC, sans-serif;
			font-size: 14px;
			font-weight: 700;
			text-decoration: none;
			box-shadow: 0 10px 28px rgba(52, 48, 44, 0.08);
		}
	}

	@media (max-width: 760px) {
		.source-topbar {
			padding: 0 16px;
		}

		.source-hero {
			width: min(100% - 28px, 1180px);
			padding: 34px 0 36px;
		}

		.source-hero h1 {
			font-size: 29px;
		}

		.source-byline {
			margin-top: 24px;
			font-size: 16px;
		}

		.source-content {
			width: min(100% - 28px, 1180px);
			gap: 38px;
		}

		.original-block {
			padding: 18px 20px;
		}

		.original-block p {
			font-size: 22px;
			line-height: 1.9;
		}

		.translation-block {
			padding-left: 8px;
		}

		.translation-block p {
			font-size: 18px;
			line-height: 1.95;
		}
	}
</style>
