---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { pageTag, pageDescription } from '../data/content';
import { withBase } from '../utils/paths';

const nanjingToolUrl = withBase('/tools/nanjing-travel-map/');
const nanjingCover = withBase('/assets/cover/cover-nanjing-route-atlas.png');
const wenxiToolUrl = 'https://wentao-tab.github.io/Wenxi-ai-clone/';
const wenxiCover = withBase('/assets/cover/cover-wenxi-prompt-atlas.png');
const sleepToolUrl = withBase('/sleep/');
---

<BaseLayout
	title="梁文韬的小工具"
	description="梁文韬的个人小工具集合，包含南京出发旅行地图等轻量工具。"
	keywords="梁文韬,小工具,南京出发,旅行地图,旅游工具"
>
	<div class="section hero">
		<div class="container">
			<SectionHeader
				tag={pageTag.tools}
				description={pageDescription.tools}>
				小工具
			</SectionHeader>

			<section class="tools-list border-top">
				<article class="tool-card">
					<a class="tool-preview" href={nanjingToolUrl} target="_blank" rel="noreferrer" aria-label="打开出发吧！从南京">
						<img src={nanjingCover} alt="金陵路线图鉴，从南京查看全国目的地路线与玩法攻略" loading="lazy" />
					</a>
					<div class="tool-info">
						<div>
							<p class="tool-kicker">TRAVEL TOOL</p>
							<h2>出发吧！从南京</h2>
							<p>一张从南京出发的旅行手账地图，用来快速比较周边目的地、交通方式和门到门耗时。</p>
						</div>
						<a class="tool-link" href={nanjingToolUrl} target="_blank" rel="noreferrer">
							打开完整工具
							<span>↗</span>
						</a>
					</div>
				</article>
				<article class="tool-card">
					<a class="tool-preview" href={wenxiToolUrl} target="_blank" rel="noreferrer" aria-label="打开提示词图鉴">
						<img src={wenxiCover} alt="提示词图鉴，汇总多场景优质提示词，一站搜索与灵感发现" loading="lazy" />
					</a>
					<div class="tool-info">
						<div>
							<p class="tool-kicker">AI TOOL</p>
							<h2>提示词图鉴</h2>
							<p>一个 AI 提示词搜索和灵感发现入口，按场景浏览、快速找到可复用的提示词模板。</p>
						</div>
						<a class="tool-link" href={wenxiToolUrl} target="_blank" rel="noreferrer">
							打开完整工具
							<span>↗</span>
						</a>
					</div>
				</article>
				<article class="tool-card">
					<a class="tool-preview forest-preview" href={sleepToolUrl} aria-label="打开鸟鸣睡眠舱">
						<div class="preview-sky" aria-hidden="true">
							<span></span><span></span><span></span><span></span>
						</div>
						<div class="preview-copy">
							<p>Birds Only</p>
							<strong>鸟鸣睡眠舱</strong>
						</div>
					</a>
					<div class="tool-info">
						<div>
							<p class="tool-kicker">SLEEP TOOL</p>
							<h2>鸟鸣睡眠舱</h2>
							<p>参考 tree.fm 的极简首屏交互，只放南京奥体鸟鸣，用来学习、工作和睡前放松。</p>
						</div>
						<a class="tool-link" href={sleepToolUrl}>
							打开完整工具
							<span>↗</span>
						</a>
					</div>
				</article>
			</section>
		</div>
	</div>
</BaseLayout>

<style lang="scss">
	.tools-list {
		display: grid;
		gap: 22px;
		max-width: 980px;
		margin: 20px auto 0;
		padding-top: 30px;
	}

	.tool-card {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: 24px;
		align-items: stretch;
		padding: 18px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(247, 252, 248, 0.72)),
			var(--color-999);
		box-shadow: 0 24px 72px rgba(27, 72, 92, 0.08);
	}

	.tool-preview {
		position: relative;
		display: block;
		height: 330px;
		overflow: hidden;
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 6px;
		background: #f4efe6;
		text-decoration: none;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.48);
	}

	.tool-preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.55s ease;
	}

	.tool-preview::after {
		content: "打开工具 ↗";
		position: absolute;
		right: 16px;
		bottom: 16px;
		padding: 8px 13px;
		border-radius: 999px;
		background: rgba(17, 17, 17, 0.76);
		color: #fff;
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1;
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.22s ease, transform 0.22s ease;
	}

	.tool-preview:hover img {
		transform: scale(1.035);
	}

	.tool-preview:hover::after {
		opacity: 1;
		transform: translateY(0);
	}

	.forest-preview {
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at 50% 34%, rgba(255, 246, 207, 0.82), transparent 24%),
			linear-gradient(180deg, #dfe8dc 0%, #e9ede3 44%, #809078 100%);
	}

	.preview-sky {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.preview-sky::before {
		content: "";
		position: absolute;
		inset: auto -8% 0;
		height: 48%;
		background: linear-gradient(180deg, rgba(111, 132, 107, 0.2), rgba(61, 78, 58, 0.76));
		clip-path: polygon(0 68%, 12% 54%, 24% 64%, 36% 42%, 48% 58%, 62% 38%, 76% 56%, 90% 42%, 100% 54%, 100% 100%, 0 100%);
	}

	.preview-sky span {
		position: absolute;
		top: 28%;
		left: -12%;
		width: 38px;
		height: 16px;
		animation: preview-fly 18s linear infinite;
	}

	.preview-sky span::before,
	.preview-sky span::after {
		content: "";
		position: absolute;
		top: 7px;
		width: 20px;
		height: 8px;
		border-top: 2px solid rgba(29, 42, 34, 0.58);
	}

	.preview-sky span::before {
		right: 18px;
		border-radius: 100% 0 0;
	}

	.preview-sky span::after {
		left: 18px;
		border-radius: 0 100% 0 0;
	}

	.preview-sky span:nth-child(2) {
		top: 22%;
		animation-delay: -7s;
		transform: scale(0.72);
	}

	.preview-sky span:nth-child(3) {
		top: 40%;
		animation-delay: -12s;
		transform: scale(0.55);
	}

	.preview-sky span:nth-child(4) {
		top: 16%;
		animation-delay: -15s;
		transform: scale(0.45);
		opacity: 0.72;
	}

	.preview-copy {
		position: relative;
		z-index: 2;
		display: grid;
		gap: 12px;
		text-align: center;
	}

	.preview-copy p {
		margin: 0;
		color: rgba(29, 42, 34, 0.56);
		font-family: var(--font-type);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
	}

	.preview-copy strong {
		color: #1d2a22;
		font-family: 'Huiwen-mincho', serif;
		font-size: clamp(2rem, 5vw, 3.6rem);
		font-weight: 400;
		line-height: 1;
	}

	.tool-info {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 24px;
		padding: 8px 6px 6px;
	}

	.tool-kicker {
		display: inline-flex;
		margin: 0 0 14px;
		padding: 7px 12px;
		border-radius: 999px;
		background: var(--color-yellow);
		color: var(--color-100);
		font-family: var(--font-type);
		font-size: 0.78rem;
		line-height: 1;
	}

	.tool-info h2 {
		margin: 0 0 14px;
		color: var(--color-100);
		font-size: clamp(1.8rem, 3vw, 2.45rem);
		line-height: 1.18;
		text-align: left;
	}

	.tool-info p:not(.tool-kicker) {
		max-width: 28em;
		margin: 0;
		color: var(--color-300);
		font-size: 1rem;
		line-height: 1.85;
		text-align: left;
	}

	.tool-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: fit-content;
		min-height: 42px;
		padding: 0 18px;
		border-radius: 999px;
		background: #111;
		color: #fff;
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
	}

	.tool-link:hover {
		transform: translateY(-1px);
		background: #8b6a2b;
		box-shadow: 0 16px 30px rgba(139, 106, 43, 0.16);
		text-decoration: none;
	}

	.tool-link span {
		font-size: 1.1rem;
		line-height: 1;
	}

	@keyframes preview-fly {
		0% { translate: -10% 0; }
		100% { translate: 1280% -40px; }
	}

	@media(max-width: 767px) {
		.tool-card {
			grid-template-columns: 1fr;
			gap: 18px;
			padding: 14px;
		}

		.tool-preview {
			height: 260px;
		}

		.tool-info {
			padding: 0 2px 2px;
		}

		.tool-link {
			width: 100%;
		}
	}
</style>
