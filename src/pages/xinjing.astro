---
import MainHead from "../components/MainHead.astro";
import ClassicReader from "../components/ClassicReader.astro";
import { heartSutraReader as reader } from "../data/classicReaders";
---

<html lang="zh-CN">
	<head>
		<MainHead
			title={reader.seoTitle}
			description={reader.description}
			keywords={reader.keywords}
			canonicalPath="/xinjing/"
		/>
	</head>
	<body class="classic-reader-body">
		<ClassicReader reader={reader} />
	</body>
</html>
