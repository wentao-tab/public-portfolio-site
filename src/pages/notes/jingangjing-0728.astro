---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import DetailInteractions from "../../components/DetailInteractions.astro";
import { withBase } from "../../utils/paths";
---

<BlogPostLayout
	title="须菩提发问"
	description="真正会学的人，不怕把最根本的问题反复问。"
	keywords="金刚经,须菩提发问,读书感悟,阅读笔记"
	canonicalPath="/notes/jingangjing-0728/"
>
	<main class="reading-note">
		<section class="note-hero">
			<img src={withBase('/assets/cover/header-jingangjing-0610.png')} alt="金刚经的读后感悟" />
		</section>

		<article class="note-content">
			<a class="note-back" href={withBase('/')} aria-label="返回首页">
				<span>←</span>
				返回首页
			</a>
			<div class="note-meta">READING NOTE · 2026.07.28</div>
			<h1 class="font-huiwen">须菩提发问</h1>
			<p class="lead">真正会学的人，不怕把最根本的问题反复问。</p>

			<p>《金刚经》里须菩提一直在问：云何应住？云何降伏其心？这个问题看似重复，其实很重要。因为真正难的东西，不是听一遍就结束，而是每到一个层次，都要重新问。</p>
			<p>学习也是这样。第一次问，是不知道；第二次问，是知道自己没懂；第三次问，是开始追问怎么用。好问题不会过期，只会随着人变深。</p>
			<p>所以不要嫌自己老在问同一个问题。只要每次问得更具体，就是进步。</p>

			<section class="note-reminder">
				<h2>今日小提醒</h2>
				<p>今天把一个困扰你的老问题重写一遍，让它比以前更具体。</p>
			</section>
		</article>
		<DetailInteractions
			articleSelector=".note-content"
			storageKey="jingangjing-0728-comments"
		/>
	</main>
</BlogPostLayout>

<style lang="scss">
	:global(.train-1) {
		display: none !important;
	}

	.reading-note {
		width: 100%;
		margin: 0 auto 88px;
	}

	.note-hero {
		width: min(1120px, calc(100vw - 48px));
		margin: 56px auto 72px;

		img {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.note-back {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin: 0 0 22px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-400);
		font-size: 0.86rem;
		line-height: 1;
		text-decoration: none;
		transition: color 0.22s ease, transform 0.22s ease;

		span {
			font-size: 0.95rem;
			transform: translateY(-1px);
		}

		&:hover {
			transform: translateX(-3px);
			color: #8b6a2b;
			text-decoration: none;
		}
	}

	.note-content {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 24px;

		h1 {
			margin: 12px 0 32px;
			font-family: 'Huiwen-mincho', serif !important;
			font-size: clamp(2.6rem, 4.2vw, 4rem);
			font-weight: 400;
			line-height: 1.18;
			color: var(--color-100);
			letter-spacing: 0;
			text-align: left;
		}

		p {
			margin: 0 0 1.35em;
			color: var(--color-200);
			font-size: 1.08rem;
			line-height: 2.05;
		}

		.lead {
			color: #8b6a2b;
			font-family: 'Huiwen-mincho', var(--font-body);
			font-size: clamp(1.55rem, 3vw, 2rem);
			line-height: 1.6;
			margin-bottom: 1.45em;
		}
	}

	.note-meta {
		margin-bottom: 12px;
		color: #9b7532;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.note-reminder {
		margin-top: 46px;
		padding: 28px 30px;
		border: 1px solid rgba(139, 106, 43, 0.22);
		border-radius: 2px;
		background: rgba(255, 248, 232, 0.54);

		h2 {
			margin: 0 0 12px;
			color: #8b6a2b;
			font-family: var(--font-mono);
			font-size: 0.9rem;
			letter-spacing: 0.05em;
		}

		p {
			margin: 0;
		}
	}

	@media (max-width: 768px) {
		.note-hero {
			width: calc(100vw - 24px);
			margin: 34px auto 48px;
		}

		.note-content {
			padding: 0 22px;
		}

		.note-reminder {
			padding: 22px;
		}
	}
</style>
