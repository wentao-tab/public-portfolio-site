---
import { Image } from 'astro:assets';
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import {pageTag, pageDescription,aboutTdk} from '../data/content';
import myPortrait from "../assets/portrait.jpg";
---
<BlogPostLayout
	title={aboutTdk.title || ''}
	description = {aboutTdk.description || ''}
	keywords = {aboutTdk.keywords || ''}
>

	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.about}
				description={pageDescription.about}>
				 关于我
			</SectionHeader>
			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div>
						<Image src={myPortrait} alt="portrait" width="88" height="88" class="portrait">
					</div>
					<p>
						我是 <strong style="font-size:1.2em">梁文韬</strong>，一名关注产品和设计的创作者，喜欢把想法打磨成清晰、好用、有质感的体验。
					</p>
					<p>
						我也长期保持阅读和记录，从书里整理方法、观点和灵感，再把它们放回到产品、设计与日常创作里。
					</p>

				</div>
			</section>
			<section>
				<h3 class="post-title">工作之外</h3>
				<div class="content">
					<p>
						除了日常工作之外，我会把部分时间投入到个人项目、阅读和知识整理中。关注产品如何解决真实问题，也关注设计如何让信息更清楚、体验更自然。
					</p>
					<p>如果你也对产品、设计或读书感兴趣，欢迎和我聊聊。</p>
					<p style="margin-top:24px;">
						<CallToAction
						target="_self"
						href="mailto:hello@uiineed.com"
						>
							联系我
						</CallToAction>
					</p>
				</div>
			</section>
			<p></p>
			<p></p>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		margin:0 auto;
	}
	p{
		margin:0.75rem 0;
	}
	figure{
		margin:2rem 0;
	}
	img{max-width: 100%;}
	.portrait{
		border-radius: 100px;
		margin:12px 0 12px;
		overflow: hidden;
		text-align: left;
	}
	a, a:link{
		color:var(--color-blue);
	}
</style>
