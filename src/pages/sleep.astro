---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const birdAudio = withBase('/assets/audio/nanjing-olympic-birds-0601.mp4');
const forestImage = 'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=900&q=85';
---

<BaseLayout
	title="林籁 fm｜梁文韬"
	description="只播放鸟鸣的沉浸式白噪音空间，适合学习、工作和睡前放松。"
	keywords="林籁,fm,鸟鸣,白噪音,失眠,助眠,学习,工作,梁文韬"
>
	<main class="forest-page" data-forest-page>
		<header class="forest-nav">
			<a class="home-link" href={withBase('/')} aria-label="返回首页">Linlai fm</a>
			<button class="about-button" type="button" data-about-open>About</button>
		</header>

		<section class="cover-screen" aria-label="林籁 fm 鸟鸣入口">
			<div class="forest-card" aria-hidden="true">
				<img src={forestImage} alt="" loading="eager" />
			</div>

			<h1>
				<span>林籁</span>
				<em>fm</em>
			</h1>

			<button class="listen-button" type="button" data-enter-button>
				<span data-listen-label>凌晨4点钟的鸟叫</span>
				<i aria-hidden="true"></i>
			</button>

			<p class="intro">风过林梢，鸟落枝头。世界安静下来，只剩一片温柔的沙沙声，像月光在树叶上写字，一撇一捺，都是安眠的韵脚。</p>
		</section>

		<section class="player-screen" aria-label="南京奥体鸟鸣播放页">
			<div class="player-bg" aria-hidden="true">
				<img src={forestImage} alt="" loading="eager" />
			</div>
			<div class="player-shade" aria-hidden="true"></div>

			<div class="native-player">
				<audio data-bird-audio src={birdAudio} preload="auto" loop playsinline controls></audio>
			</div>

			<div class="player-bottom">
				<button class="player-button" type="button" data-player-button aria-label="暂停或继续播放鸟鸣">
					<span data-player-icon aria-hidden="true"></span>
					<strong data-player-label>暂停鸟鸣</strong>
				</button>
				<div class="sound-meta" data-sound-meta>
					<span data-sound-status>等待开始</span>
				</div>
			</div>
		</section>

		<div class="about-layer" data-about-layer hidden>
			<button class="about-backdrop" type="button" data-about-close aria-label="关闭关于"></button>
			<aside class="about-panel" aria-label="关于林籁 fm">
				<button class="about-close" type="button" data-about-close aria-label="关闭关于">×</button>
				<p class="about-kicker">ABOUT</p>
				<h2>关于林籁 fm</h2>
				<p>我是 <strong>梁文韬</strong>，一名关注产品和设计的创作者，喜欢把想法打磨成清晰、好用、有质感的体验。</p>
				<p>我也长期保持阅读和记录，从书里整理方法、观点和灵感，再把它们放回到产品、设计与日常创作里。</p>
				<p>除了日常工作之外，我会把部分时间投入到个人项目、阅读和知识整理中。关注产品如何解决真实问题，也关注设计如何让信息更清楚、体验更自然。</p>
				<p>如果你也对产品、设计或读书感兴趣，欢迎和我聊聊。</p>
			</aside>
		</div>
	</main>
</BaseLayout>

<script>
	const page = document.querySelector('[data-forest-page]');
	const enterButton = document.querySelector('[data-enter-button]') as HTMLButtonElement | null;
	const playerButton = document.querySelector('[data-player-button]') as HTMLButtonElement | null;
	const status = document.querySelector('[data-sound-status]');
	const playerLabel = document.querySelector('[data-player-label]');
	const audio = document.querySelector('[data-bird-audio]') as HTMLAudioElement | null;
	const aboutLayer = document.querySelector('[data-about-layer]') as HTMLElement | null;
	const aboutOpen = document.querySelector('[data-about-open]') as HTMLButtonElement | null;
	const aboutCloseButtons = [...document.querySelectorAll('[data-about-close]')] as HTMLButtonElement[];

	const setPlaying = (playing: boolean) => {
		page?.classList.toggle('is-playing', playing);
		if (status) status.textContent = playing ? '南京奥体 · 6.1 鸟鸣正在播放' : '等待开始';
		if (playerLabel) playerLabel.textContent = playing ? '暂停鸟鸣' : '继续鸟鸣';
	};

	const enterPlayer = () => {
		page?.classList.add('is-player');
		if (window.location.hash !== '#forest') history.pushState(null, '', '#forest');
	};

	const randomSeek = () => {
		if (!audio || !Number.isFinite(audio.duration) || audio.duration <= 12) return;
		audio.currentTime = Math.random() * Math.max(audio.duration - 10, 0);
	};

	const playBirds = async () => {
		if (!audio) return;
		audio.volume = 0.72;
		randomSeek();
		try {
			await audio.play();
			setPlaying(true);
		} catch {
			setPlaying(false);
			if (status) status.textContent = '浏览器拦截了自动播放，请再点一次';
		}
	};

	enterButton?.addEventListener('click', () => {
		enterPlayer();
		void playBirds();
	});

	playerButton?.addEventListener('click', () => {
		if (!audio) return;
		if (audio.paused) {
			void playBirds();
			return;
		}
		audio.pause();
	});

	audio?.addEventListener('loadedmetadata', () => {
		if (page?.classList.contains('is-playing')) randomSeek();
	});
	audio?.addEventListener('play', () => setPlaying(true));
	audio?.addEventListener('playing', () => setPlaying(true));
	audio?.addEventListener('pause', () => setPlaying(false));

	if (window.location.hash === '#forest') {
		page?.classList.add('is-player');
	}

	window.addEventListener('popstate', () => {
		page?.classList.toggle('is-player', window.location.hash === '#forest');
	});

	aboutOpen?.addEventListener('click', () => {
		aboutLayer?.removeAttribute('hidden');
		page?.classList.add('is-about-open');
	});

	aboutCloseButtons.forEach((button) => {
		button.addEventListener('click', () => {
			aboutLayer?.setAttribute('hidden', '');
			page?.classList.remove('is-about-open');
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		aboutLayer?.setAttribute('hidden', '');
		page?.classList.remove('is-about-open');
	});
</script>

<style lang="scss">
	:global(nav),
	:global(footer),
	:global(.train-1) {
		display: none !important;
	}

	:global(html) {
		background: #001b07;
	}

	:global(body) {
		background: #001b07;
	}

	.forest-page {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
		background: #001b07;
		color: #fff;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
	}

	.forest-nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 24px 32px;
	}

	.home-link {
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.88rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	.about-button {
		min-height: 42px;
		padding: 0 18px;
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-radius: 999px;
		background: transparent;
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.02rem;
		font-weight: 300;
		cursor: pointer;
		transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
	}

	.about-button:hover {
		transform: translateY(-1px);
		border-color: rgba(255, 255, 255, 0.66);
		background: rgba(255, 255, 255, 0.08);
	}

	.cover-screen,
	.player-screen {
		position: relative;
		z-index: 2;
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 72px 24px;
		text-align: center;
	}

	.cover-screen {
		transition: opacity 0.42s ease, transform 0.42s ease, visibility 0.42s ease;
	}

	.is-player .cover-screen {
		visibility: hidden;
		opacity: 0;
		transform: scale(0.985);
		pointer-events: none;
	}

	.forest-card {
		position: absolute;
		top: 14vh;
		left: 50%;
		width: min(27vw, 430px);
		min-width: 300px;
		aspect-ratio: 0.79;
		overflow: hidden;
		background: #06300d;
		transform: translateX(-50%);
		box-shadow: none;
	}

	.forest-card::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(0, 28, 6, 0.1), rgba(0, 22, 4, 0.48)),
			radial-gradient(circle at 50% 38%, transparent 0 30%, rgba(0, 16, 4, 0.42) 82%);
	}

	.forest-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.82) brightness(0.5) contrast(1.06);
	}

	h1 {
		position: relative;
		z-index: 3;
		display: inline-flex;
		align-items: flex-start;
		justify-content: center;
		gap: 0.08em;
		margin: 0 0 92px;
		color: #fff;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif !important;
		font-size: clamp(5.2rem, 14.2vw, 15rem);
		font-weight: 200;
		line-height: 0.88;
		letter-spacing: 0;
		text-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
	}

	h1 em {
		margin-top: 0.02em;
		font-family: inherit;
		font-size: 0.2em;
		font-weight: 300;
		font-style: normal;
		line-height: 1;
	}

	.listen-button {
		position: absolute;
		z-index: 4;
		top: 58vh;
		left: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		min-height: 68px;
		padding: 0 10px 0 30px;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		color: #04210a;
		font-size: clamp(0.94rem, 1.2vw, 1.1rem);
		font-weight: 650;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		cursor: pointer;
		transform: translate(-50%, -50%);
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.listen-button:hover {
		transform: translate(-50%, -52%);
		box-shadow: 0 32px 88px rgba(0, 0, 0, 0.32);
	}

	.listen-button i,
	[data-player-icon] {
		position: relative;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: #d7ecd4;
	}

	.listen-button i::before,
	[data-player-icon]::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 52%;
		width: 0;
		height: 0;
		border-top: 9px solid transparent;
		border-bottom: 9px solid transparent;
		border-left: 13px solid #002407;
		transform: translate(-42%, -50%);
	}

	.is-playing [data-player-icon]::before {
		left: 50%;
		width: 13px;
		height: 18px;
		border: 0;
		border-right: 4px solid #002407;
		border-left: 4px solid #002407;
		transform: translate(-50%, -50%);
	}

	.intro {
		position: absolute;
		left: 50%;
		bottom: 6.8vh;
		z-index: 3;
		width: min(880px, calc(100vw - 42px));
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: clamp(1rem, 1.18vw, 1.18rem);
		font-weight: 300;
		line-height: 1.9;
		transform: translateX(-50%);
	}

	.player-screen {
		position: absolute;
		inset: 0;
		visibility: hidden;
		opacity: 0;
		transition: opacity 0.42s ease, visibility 0.42s ease;
		pointer-events: none;
	}

	.is-player .player-screen {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
	}

	.player-bg,
	.player-bg img,
	.player-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.player-bg img {
		display: block;
		object-fit: cover;
		filter: saturate(0.9) brightness(0.64) contrast(1.06);
	}

	.player-shade {
		background:
			linear-gradient(180deg, rgba(0, 20, 6, 0.18), rgba(0, 14, 4, 0.18) 42%, rgba(0, 9, 2, 0.74)),
			radial-gradient(circle at 50% 50%, transparent 0 36%, rgba(0, 14, 3, 0.52) 100%);
	}

	.native-player {
		position: relative;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.native-player audio {
		width: min(360px, calc(100vw - 72px));
		height: 44px;
		opacity: 0.94;
	}

	.player-bottom {
		position: absolute;
		left: 50%;
		bottom: 6.4vh;
		z-index: 4;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(620px, calc(100vw - 36px));
		transform: translateX(-50%);
	}

	.player-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		min-width: 178px;
		min-height: 64px;
		padding: 0 26px 0 10px;
		border: 1px solid rgba(255, 255, 255, 0.74);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		font: inherit;
		font-weight: 500;
		cursor: pointer;
		backdrop-filter: blur(10px);
		transition: background 0.22s ease, transform 0.22s ease;
	}

	.player-button:hover {
		transform: translateY(-1px);
		background: rgba(255, 255, 255, 0.14);
	}

	.sound-meta {
		margin-top: 18px;
		color: rgba(255, 255, 255, 0.74);
		font-size: 0.9rem;
		font-weight: 300;
	}

	.about-layer {
		position: fixed;
		inset: 0;
		z-index: 20;
		display: block;
	}

	.about-layer[hidden] {
		display: none;
	}

	.about-backdrop {
		position: absolute;
		inset: 0;
		border: 0;
		background: rgba(0, 15, 4, 0.42);
		cursor: pointer;
		backdrop-filter: blur(8px);
	}

	.about-panel {
		position: absolute;
		top: 82px;
		right: 34px;
		width: min(410px, calc(100vw - 36px));
		padding: 30px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 8px;
		background: rgba(4, 27, 9, 0.92);
		color: #fff;
		box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
		backdrop-filter: blur(24px) saturate(140%);
		animation: about-in 0.26s ease both;
	}

	.about-close {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 34px;
		height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.75);
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
	}

	.about-kicker {
		margin: 0 0 12px;
		color: rgba(255, 255, 255, 0.48);
		font-family: var(--font-type);
		font-size: 0.76rem;
		letter-spacing: 0.14em;
	}

	.about-panel h2 {
		margin: 0 0 18px;
		color: #fff;
		font-family: inherit;
		font-size: 1.7rem;
		font-weight: 300;
		line-height: 1.2;
		text-align: left;
	}

	.about-panel p:not(.about-kicker) {
		margin: 0 0 1em;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.98rem;
		line-height: 1.9;
	}

	.about-panel p:last-child {
		margin-bottom: 0;
	}

	@keyframes about-in {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media(max-width: 767px) {
		.forest-nav {
			padding: 20px;
		}

		.home-link {
			font-size: 0.88rem;
		}

		.about-button {
			min-height: 38px;
			padding: 0 14px;
		}

		.forest-card {
			top: 18vh;
			width: 62vw;
			min-width: 230px;
		}

		h1 {
			margin-bottom: 80px;
			font-size: clamp(4.2rem, 20vw, 7.2rem);
		}

		.listen-button {
			top: 59vh;
			min-height: 58px;
			padding-left: 22px;
			gap: 12px;
			white-space: nowrap;
		}

		.listen-button i {
			width: 42px;
			height: 42px;
		}

		.intro {
			bottom: 7vh;
			font-size: 0.94rem;
			line-height: 1.75;
		}

		.player-bottom {
			bottom: 6vh;
		}

		.player-button {
			min-height: 58px;
			padding-right: 20px;
		}

		[data-player-icon] {
			width: 42px;
			height: 42px;
		}

		.about-panel {
			top: 72px;
			right: 16px;
			padding: 24px;
		}
	}
</style>
