---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const forestImage = withBase('/assets/cover/cover-linlai-forest.png');
const forestWideImage = withBase('/assets/cover/cover-linlai-forest-wide.webp');
const forestPortraitImage = withBase('/assets/cover/cover-linlai-forest-portrait.webp');
const forestCardImage = withBase('/assets/cover/cover-linlai-forest-card.webp');
const sounds = [
	{
		title: '四点鸟鸣',
		status: '四点鸟鸣正在播放',
		src: withBase('/assets/audio/nanjing-olympic-birds-0601.mp4'),
	},
	{
		title: '晨林微光',
		status: '晨林微光正在播放',
		src: withBase('/assets/audio/soundscape-abaca-09uhr10.mp3'),
	},
	{
		title: '山夜入眠',
		status: '山夜入眠正在播放',
		src: withBase('/assets/audio/hochschwendberg-overnight.mp3'),
	},
	{
		title: '雪岭松风',
		status: '雪岭松风正在播放',
		src: withBase('/assets/audio/sierra-nevada.mp3'),
	},
];
---

<BaseLayout
	title="林籁 fm｜梁文韬"
	description="只播放鸟鸣的沉浸式白噪音空间，适合学习、工作和睡前放松。"
	keywords="林籁,fm,鸟鸣,白噪音,失眠,助眠,学习,工作,梁文韬"
	favicon={withBase('/assets/favicon/linlai-favicon.png')}
>
	<main class="forest-page" data-forest-page>
		<header class="forest-nav">
			<a class="home-link" href={withBase('/')} aria-label="返回首页">Linlai fm</a>
			<button class="player-back" type="button" data-player-back aria-label="返回林籁 fm 首页">← Back</button>
			<button class="about-button" type="button" data-about-open>About</button>
		</header>

		<section class="cover-screen" aria-label="林籁 fm 鸟鸣入口">
			<div class="cover-bg" aria-hidden="true">
				<picture>
					<source media="(max-width: 767px)" srcset={forestPortraitImage} type="image/webp" />
					<source srcset={forestWideImage} type="image/webp" />
					<img src={forestImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
				</picture>
			</div>
			<button class="forest-card" type="button" data-entry-card aria-label="进入林籁 fm 播放页">
				<img src={forestCardImage} alt="" loading="eager" decoding="async" />
			</button>

			<h1>
				<span>林籁</span>
				<em>fm</em>
			</h1>

			<button class="listen-button" type="button" data-enter-button>
				<span data-listen-label>{sounds[0].title}</span>
				<i aria-hidden="true"></i>
			</button>

			<p class="intro">
				<span>风过林梢，鸟落枝头。</span>
				<span class="intro-detail">
					<span>世界安静下来，只剩一片温柔的沙沙声，</span>
					<span>像月光在树叶上写字，一撇一捺，</span>
					<span>都是安眠的韵脚。</span>
				</span>
			</p>
		</section>

		<div class="entry-expander" aria-hidden="true" data-entry-expander></div>

		<section class="player-screen" aria-label="南京奥体鸟鸣播放页">
			<div class="player-bg" aria-hidden="true">
				<picture>
					<source media="(max-width: 767px)" srcset={forestPortraitImage} type="image/webp" />
					<source srcset={forestWideImage} type="image/webp" />
					<img src={forestImage} alt="" loading="lazy" decoding="async" />
				</picture>
			</div>
			<div class="player-shade" aria-hidden="true"></div>

			<div class="native-player">
				<audio data-bird-audio preload="none" loop playsinline controls></audio>
			</div>

			<div class="player-bottom">
				<button class="player-button" type="button" data-player-button aria-label="暂停或继续播放鸟鸣">
					<span data-player-icon aria-hidden="true"></span>
					<strong data-player-label>stop</strong>
				</button>
				<div class="sound-meta" data-sound-meta>
					<span data-sound-status>等待开始</span>
				</div>
				<button class="next-journey" type="button" data-next-journey>
					<span>下一段自由之旅</span>
					<i aria-hidden="true">→</i>
				</button>
			</div>
		</section>

		<div class="about-layer" data-about-layer hidden>
			<button class="about-backdrop" type="button" data-about-close aria-label="关闭关于"></button>
			<aside class="about-panel" aria-label="关于林籁 fm">
				<button class="about-close" type="button" data-about-close aria-label="关闭关于">×</button>
				<p class="about-kicker">ABOUT</p>
				<h2>关于林籁 fm</h2>
				<p>工作久了，人会忘记安静的轮廓。于是做了这个声音角落，录下林间的风，和树梢上忽远忽近的鸟鸣。</p>
				<p>它们不替你做决定，也不灌输什么道理，只是用持续的、微小的声响，把你从紧绷里一点一点接回来。</p>
				<p>戴上耳机，闭眼，剩下的交给森林。</p>
			</aside>
		</div>
	</main>
</BaseLayout>

<script id="forest-sounds" type="application/json" set:html={JSON.stringify(sounds)} is:inline></script>

<script>
	const page = document.querySelector('[data-forest-page]');
	const soundData = document.querySelector('#forest-sounds')?.textContent ?? '[]';
	const sounds = JSON.parse(soundData) as Array<{ title: string; status: string; src: string }>;
	const enterButton = document.querySelector('[data-enter-button]') as HTMLButtonElement | null;
	const entryCard = document.querySelector('[data-entry-card]') as HTMLButtonElement | null;
	const entryExpander = document.querySelector('[data-entry-expander]') as HTMLElement | null;
	const playerScreen = document.querySelector('.player-screen') as HTMLElement | null;
	const playerButton = document.querySelector('[data-player-button]') as HTMLButtonElement | null;
	const playerBack = document.querySelector('[data-player-back]') as HTMLButtonElement | null;
	const nextJourney = document.querySelector('[data-next-journey]') as HTMLButtonElement | null;
	const listenLabel = document.querySelector('[data-listen-label]');
	const status = document.querySelector('[data-sound-status]');
	const playerLabel = document.querySelector('[data-player-label]');
	const audio = document.querySelector('[data-bird-audio]') as HTMLAudioElement | null;
	const aboutLayer = document.querySelector('[data-about-layer]') as HTMLElement | null;
	const aboutOpen = document.querySelector('[data-about-open]') as HTMLButtonElement | null;
	const aboutCloseButtons = [...document.querySelectorAll('[data-about-close]')] as HTMLButtonElement[];
	let currentSoundIndex = 0;

	const getCurrentSound = () => sounds[currentSoundIndex] ?? sounds[0];

	const setLoadingAudio = (loading: boolean) => {
		page?.classList.toggle('is-loading-audio', loading);
		if (playerButton) playerButton.disabled = loading;
		if (enterButton) enterButton.disabled = loading;
		if (entryCard) entryCard.disabled = loading;
		if (status) status.textContent = loading ? '正在唤醒森林...' : audio?.paused ? '等待开始' : getCurrentSound().status;
		if (playerLabel) playerLabel.textContent = loading ? 'loading' : audio?.paused ? 'begin' : 'stop';
	};

	const ensureAudioSource = () => {
		if (!audio) return;
		const sound = getCurrentSound();
		if (audio.currentSrc.endsWith(sound.src) || audio.getAttribute('src') === sound.src) return;
		audio.src = sound.src;
		audio.load();
	};

	const syncSoundText = () => {
		const sound = getCurrentSound();
		if (listenLabel) listenLabel.textContent = sound.title;
		if (status && !page?.classList.contains('is-playing') && !page?.classList.contains('is-loading-audio')) status.textContent = '等待开始';
	};

	const setPlaying = (playing: boolean) => {
		page?.classList.toggle('is-playing', playing);
		if (status) status.textContent = playing ? getCurrentSound().status : '等待开始';
		if (playerLabel) playerLabel.textContent = playing ? 'stop' : 'begin';
	};

	const setImmersive = (immersive: boolean) => {
		page?.classList.toggle('is-immersive', immersive);
	};

	const enterPlayer = (animate = true) => {
		if (!page || page.classList.contains('is-player') || page.classList.contains('is-entering')) return;
		if (!animate || !entryCard || !entryExpander) {
			page.classList.add('is-player');
			if (window.location.hash !== '#forest') history.pushState(null, '', '#forest');
			return;
		}

		page.classList.add('is-entering');

		window.setTimeout(() => {
			page.classList.add('is-player');
			if (window.location.hash !== '#forest') history.pushState(null, '', '#forest');
		}, 520);

		window.setTimeout(() => {
			page.classList.remove('is-entering');
		}, 1040);
	};

	const exitPlayer = () => {
		audio?.pause();
		setPlaying(false);
		setImmersive(false);
		page?.classList.remove('is-entering');
		page?.classList.remove('is-player');
		if (window.location.hash === '#forest') {
			history.pushState(null, '', window.location.pathname + window.location.search);
		}
	};

	const enterImmersive = async () => {
		if (!page?.classList.contains('is-player')) return;
		if (!aboutLayer?.hasAttribute('hidden')) aboutLayer?.setAttribute('hidden', '');
		page?.classList.remove('is-about-open');

		try {
			if (!document.fullscreenElement) await page?.requestFullscreen?.();
		} catch {
			// Some browsers can reject fullscreen; keep the page-level immersive mode.
		}
		setImmersive(true);
	};

	const exitImmersive = async () => {
		setImmersive(false);
		try {
			if (document.fullscreenElement) await document.exitFullscreen?.();
		} catch {
			setImmersive(false);
		}
	};

	const toggleImmersive = () => {
		if (page?.classList.contains('is-immersive') || document.fullscreenElement) {
			void exitImmersive();
			return;
		}
		void enterImmersive();
	};

	const randomSeek = () => {
		if (!audio || !Number.isFinite(audio.duration) || audio.duration <= 12) return;
		audio.currentTime = Math.random() * Math.max(audio.duration - 10, 0);
	};

	const switchSound = (index: number) => {
		if (!audio || sounds.length === 0) return;
		currentSoundIndex = (index + sounds.length) % sounds.length;
		audio.pause();
		audio.removeAttribute('src');
		audio.load();
		syncSoundText();
	};

	const playBirds = async () => {
		if (!audio) return;
		ensureAudioSource();
		audio.volume = 0.72;
		setLoadingAudio(true);
		try {
			if (audio.readyState >= 1) randomSeek();
			await audio.play();
			setPlaying(true);
		} catch (error) {
			setPlaying(false);
			if ((error as DOMException).name !== 'AbortError' && status) {
				status.textContent = '等待开始';
			}
		} finally {
			setLoadingAudio(false);
		}
	};

	enterButton?.addEventListener('click', () => {
		enterPlayer();
		void playBirds();
	});

	entryCard?.addEventListener('click', () => {
		enterPlayer();
		void playBirds();
	});

	playerButton?.addEventListener('click', () => {
		if (!audio) return;
		if (audio.paused) {
			void playBirds();
			return;
		}
		audio.pause();
	});

	nextJourney?.addEventListener('click', () => {
		switchSound(currentSoundIndex + 1);
		void playBirds();
	});

	playerBack?.addEventListener('click', exitPlayer);

	playerScreen?.addEventListener('dblclick', (event) => {
		if ((event.target as HTMLElement).closest('button, a, audio')) return;
		toggleImmersive();
	});

	let lastTouchTime = 0;
	playerScreen?.addEventListener('touchend', (event) => {
		if ((event.target as HTMLElement).closest('button, a, audio')) return;
		const now = Date.now();
		if (now - lastTouchTime < 320) {
			event.preventDefault();
			toggleImmersive();
		}
		lastTouchTime = now;
	}, { passive: false });

	document.addEventListener('fullscreenchange', () => {
		setImmersive(Boolean(document.fullscreenElement));
	});

	audio?.addEventListener('loadedmetadata', () => {
		if (page?.classList.contains('is-playing')) randomSeek();
	});
	audio?.addEventListener('play', () => setPlaying(true));
	audio?.addEventListener('playing', () => setPlaying(true));
	audio?.addEventListener('pause', () => setPlaying(false));

	syncSoundText();

	if (window.location.hash === '#forest') {
		enterPlayer(false);
		void playBirds();
	}

	window.addEventListener('popstate', () => {
		if (window.location.hash === '#forest') {
			page?.classList.add('is-player');
			void playBirds();
			return;
		}
		audio?.pause();
		setPlaying(false);
		page?.classList.remove('is-entering');
		page?.classList.remove('is-player');
	});

	aboutOpen?.addEventListener('click', () => {
		aboutLayer?.removeAttribute('hidden');
		page?.classList.add('is-about-open');
	});

	aboutCloseButtons.forEach((button) => {
		button.addEventListener('click', () => {
			aboutLayer?.setAttribute('hidden', '');
			page?.classList.remove('is-about-open');
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key.toLowerCase() === 'f' && page?.classList.contains('is-player')) {
			event.preventDefault();
			toggleImmersive();
			return;
		}
		if (event.key !== 'Escape') return;
		if (page?.classList.contains('is-immersive') || document.fullscreenElement) {
			setImmersive(false);
			return;
		}
		if (!aboutLayer?.hasAttribute('hidden')) {
			aboutLayer?.setAttribute('hidden', '');
			page?.classList.remove('is-about-open');
			return;
		}
		if (page?.classList.contains('is-player')) {
			exitPlayer();
		}
	});
</script>

<style lang="scss">
	:global(nav),
	:global(footer),
	:global(.train-1) {
		display: none !important;
	}

	:global(html) {
		background: #001b07;
	}

	:global(body) {
		background: #001b07;
	}

	.forest-page {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
		background: #001b07;
		color: #fff;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
	}

	.forest-nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 24px 32px;
	}

	.home-link {
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.88rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	.player-back {
		visibility: hidden;
		opacity: 0;
		justify-self: center;
		min-height: 40px;
		padding: 0 18px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 999px;
		background: rgba(0, 25, 8, 0.18);
		color: rgba(255, 255, 255, 0.78);
		font: inherit;
		font-size: 0.92rem;
		font-weight: 300;
		letter-spacing: 0.02em;
		cursor: pointer;
		backdrop-filter: blur(10px);
		transition:
			opacity 0.24s ease,
			visibility 0.24s ease,
			transform 0.24s ease,
			background 0.24s ease,
			border-color 0.24s ease,
			color 0.24s ease;
	}

	.is-player .player-back {
		visibility: visible;
		opacity: 1;
	}

	.player-back:hover {
		transform: translateX(-3px);
		border-color: rgba(255, 255, 255, 0.62);
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}

	.about-button {
		justify-self: end;
		min-height: 42px;
		padding: 0 18px;
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-radius: 999px;
		background: transparent;
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.02rem;
		font-weight: 300;
		cursor: pointer;
		transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
	}

	.about-button:hover {
		transform: translateY(-1px);
		border-color: rgba(255, 255, 255, 0.66);
		background: rgba(255, 255, 255, 0.08);
	}

	.cover-screen,
	.player-screen {
		position: relative;
		z-index: 2;
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 72px 24px;
		text-align: center;
	}

	.cover-screen {
		overflow: hidden;
		transition: opacity 0.42s ease, transform 0.42s ease, visibility 0.42s ease;
	}

	.cover-bg,
	.cover-bg picture,
	.cover-bg img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.cover-bg {
		z-index: 0;
		opacity: 0.42;
		overflow: hidden;
	}

	.cover-bg::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 18, 5, 0.78), rgba(0, 28, 7, 0.42) 42%, rgba(0, 22, 4, 0.78)),
			linear-gradient(180deg, rgba(0, 24, 6, 0.28), rgba(0, 20, 4, 0.88));
	}

	.cover-bg img {
		display: block;
		object-fit: cover;
		object-position: center;
		filter: saturate(0.82) brightness(0.48) contrast(1.08);
		transform: scale(1.32);
		transform-origin: 78% 50%;
	}

	.is-player .cover-screen {
		visibility: hidden;
		opacity: 0;
		transform: scale(0.985);
		pointer-events: none;
	}

	.forest-card {
		position: absolute;
		top: 14vh;
		left: 50%;
		width: min(27vw, 430px);
		min-width: 300px;
		aspect-ratio: 0.79;
		padding: 0;
		border: 0;
		overflow: hidden;
		background: #06300d;
		transform: translateX(-50%);
		box-shadow: 0 34px 100px rgba(0, 0, 0, 0.18);
		z-index: 1;
		cursor: pointer;
		transition:
			filter 0.36s ease,
			box-shadow 0.36s ease,
			transform 0.36s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.forest-card::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(0, 28, 6, 0.1), rgba(0, 22, 4, 0.48)),
			radial-gradient(circle at 50% 38%, transparent 0 30%, rgba(0, 16, 4, 0.42) 82%);
	}

	.forest-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 58% center;
		filter: saturate(0.82) brightness(0.5) contrast(1.06);
	}

	.cover-screen:has(.forest-card:hover) .forest-card,
	.cover-screen:has(.listen-button:hover) .forest-card {
		filter: saturate(1.06) brightness(1.08);
		transform: translate(-50%, -9px) scale(1.018);
		box-shadow: 0 42px 120px rgba(0, 0, 0, 0.28);
	}

	.is-entering .cover-screen {
		pointer-events: none;
	}

	.is-entering .listen-button,
	.is-entering h1,
	.is-entering .intro {
		opacity: 0;
		transition: opacity 0.18s ease;
	}

	h1 {
		position: relative;
		z-index: 3;
		display: inline-flex;
		align-items: flex-start;
		justify-content: center;
		gap: 0.08em;
		margin: 0 0 92px;
		color: #fff;
		font-family: "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
		font-size: clamp(5rem, 13.8vw, 14.4rem);
		font-weight: 100;
		line-height: 0.88;
		letter-spacing: 0;
		text-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
		pointer-events: none;
	}

	h1 em {
		margin-top: 0.02em;
		font-family: inherit;
		font-size: 0.2em;
		font-weight: 200;
		font-style: normal;
		line-height: 1;
	}

	.listen-button {
		position: absolute;
		z-index: 4;
		top: 71vh;
		left: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		min-height: 68px;
		padding: 0 10px 0 30px;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		color: #04210a;
		font-size: clamp(0.94rem, 1.2vw, 1.1rem);
		font-weight: 650;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		cursor: pointer;
		transform: translate(-50%, -50%);
		transition: transform 0.24s ease, box-shadow 0.24s ease, background 0.24s ease;
	}

	.listen-button:hover {
		transform: translate(-50%, -54%) scale(1.015);
		background: rgba(255, 255, 255, 0.98);
		box-shadow: 0 32px 88px rgba(0, 0, 0, 0.32);
	}

	.listen-button:disabled,
	.forest-card:disabled,
	.player-button:disabled {
		cursor: wait;
	}

	.is-loading-audio .listen-button {
		background: rgba(235, 249, 231, 0.96);
	}

	.is-loading-audio .listen-button i,
	.is-loading-audio [data-player-icon] {
		animation: loading-pulse 1.1s ease-in-out infinite;
	}

	.is-loading-audio .listen-button i::before,
	.is-loading-audio [data-player-icon]::before {
		left: 50%;
		width: 18px;
		height: 18px;
		border: 2px solid rgba(0, 36, 7, 0.28);
		border-top-color: #002407;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		animation: loading-spin 0.8s linear infinite;
	}

	.listen-button i,
	[data-player-icon] {
		position: relative;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: #d7ecd4;
	}

	.listen-button i::before,
	[data-player-icon]::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 52%;
