---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const birdAudio = withBase('/assets/audio/nanjing-olympic-birds-0601.mp4');
const forestImage = 'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=900&q=85';
---

<BaseLayout
	title="林籁 fm｜梁文韬"
	description="只播放鸟鸣的沉浸式白噪音空间，适合学习、工作和睡前放松。"
	keywords="林籁,fm,鸟鸣,白噪音,失眠,助眠,学习,工作,梁文韬"
>
	<main class="forest-page" data-forest-page>
		<header class="forest-nav">
			<a class="home-link" href={withBase('/')} aria-label="返回首页">林籁 fm</a>
			<button class="about-button" type="button" data-about-open>About</button>
		</header>

		<section class="hero" aria-label="林籁 fm 鸟鸣播放器">
			<div class="forest-card" aria-hidden="true">
				<img src={forestImage} alt="" loading="eager" />
			</div>

			<div class="bird-field" aria-hidden="true">
				<span></span><span></span><span></span><span></span><span></span>
			</div>

			<h1>
				<span>林籁</span>
				<em>fm</em>
			</h1>

			<button class="listen-button" type="button" data-listen-button>
				<span data-listen-label>凌晨4点钟的鸟叫</span>
				<i aria-hidden="true"></i>
			</button>

			<p class="intro">风过林梢，鸟落枝头。世界安静下来，只剩一片温柔的沙沙声，像月光在树叶上写字，一撇一捺，都是安眠的韵脚。</p>

			<div class="sound-meta" data-sound-meta>
				<span class="pulse"></span>
				<span data-sound-status>等待开始</span>
			</div>
		</section>

		<audio data-bird-audio src={birdAudio} preload="auto" loop playsinline></audio>

		<div class="about-layer" data-about-layer hidden>
			<button class="about-backdrop" type="button" data-about-close aria-label="关闭关于"></button>
			<aside class="about-panel" aria-label="关于林籁 fm">
				<button class="about-close" type="button" data-about-close aria-label="关闭关于">×</button>
				<p class="about-kicker">ABOUT</p>
				<h2>关于林籁 fm</h2>
				<p>我是 <strong>梁文韬</strong>，一名关注产品和设计的创作者，喜欢把想法打磨成清晰、好用、有质感的体验。</p>
				<p>我也长期保持阅读和记录，从书里整理方法、观点和灵感，再把它们放回到产品、设计与日常创作里。</p>
				<p>除了日常工作之外，我会把部分时间投入到个人项目、阅读和知识整理中。关注产品如何解决真实问题，也关注设计如何让信息更清楚、体验更自然。</p>
				<p>如果你也对产品、设计或读书感兴趣，欢迎和我聊聊。</p>
			</aside>
		</div>
	</main>
</BaseLayout>

<script>
	const page = document.querySelector('[data-forest-page]');
	const button = document.querySelector('[data-listen-button]') as HTMLButtonElement | null;
	const status = document.querySelector('[data-sound-status]');
	const audio = document.querySelector('[data-bird-audio]') as HTMLAudioElement | null;
	const aboutLayer = document.querySelector('[data-about-layer]') as HTMLElement | null;
	const aboutOpen = document.querySelector('[data-about-open]') as HTMLButtonElement | null;
	const aboutCloseButtons = [...document.querySelectorAll('[data-about-close]')] as HTMLButtonElement[];

	const setPlaying = (playing: boolean) => {
		page?.classList.toggle('is-playing', playing);
		if (status) status.textContent = playing ? '南京奥体 · 6.1 鸟鸣正在播放' : '等待开始';
	};

	const randomSeek = () => {
		if (!audio || !Number.isFinite(audio.duration) || audio.duration <= 12) return;
		audio.currentTime = Math.random() * Math.max(audio.duration - 10, 0);
	};

	const playBirds = async () => {
		if (!audio) return;
		audio.volume = 0.72;
		randomSeek();
		try {
			await audio.play();
			setPlaying(true);
		} catch {
			setPlaying(false);
			if (status) status.textContent = '浏览器拦截了自动播放，请再点一次';
		}
	};

	button?.addEventListener('click', playBirds);
	audio?.addEventListener('loadedmetadata', () => {
		if (page?.classList.contains('is-playing')) randomSeek();
	});
	audio?.addEventListener('pause', () => setPlaying(false));

	aboutOpen?.addEventListener('click', () => {
		aboutLayer?.removeAttribute('hidden');
		page?.classList.add('is-about-open');
	});

	aboutCloseButtons.forEach((button) => {
		button.addEventListener('click', () => {
			aboutLayer?.setAttribute('hidden', '');
			page?.classList.remove('is-about-open');
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		aboutLayer?.setAttribute('hidden', '');
		page?.classList.remove('is-about-open');
	});
</script>

<style lang="scss">
	:global(nav),
	:global(footer),
	:global(.train-1) {
		display: none !important;
	}

	:global(body) {
		background: #001b07;
	}

	.forest-page {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 44%, rgba(34, 94, 41, 0.22), transparent 24%),
			linear-gradient(180deg, #001b07 0%, #001905 52%, #001403 100%);
		color: #fff;
		font-family: "Inter", "Noto Sans SC", sans-serif;
	}

	.forest-page::before {
		content: "";
		position: fixed;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(0, 18, 4, 0.2), transparent 36%, rgba(0, 10, 2, 0.42)),
			repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 4px);
		mix-blend-mode: screen;
		opacity: 0.26;
	}

	.forest-nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px 34px;
	}

	.home-link {
		color: rgba(255, 255, 255, 0.72);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.98rem;
		text-decoration: none;
	}

	.about-button {
		min-height: 42px;
		padding: 0 18px;
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-radius: 999px;
		background: transparent;
		color: rgba(255, 255, 255, 0.9);
		font-size: 1rem;
		cursor: pointer;
		transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
	}

	.about-button:hover {
		transform: translateY(-1px);
		border-color: rgba(255, 255, 255, 0.66);
		background: rgba(255, 255, 255, 0.08);
	}

	.hero {
		position: relative;
		z-index: 2;
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 72px 24px 70px;
		text-align: center;
	}

	.forest-card {
		position: absolute;
		top: 14.2vh;
		left: 50%;
		width: min(28vw, 410px);
		min-width: 270px;
		aspect-ratio: 0.78;
		overflow: hidden;
		background: #06300d;
		transform: translateX(-50%);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.28);
	}

	.forest-card::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(0, 25, 6, 0.16), rgba(0, 20, 4, 0.52)),
			radial-gradient(circle at 50% 38%, transparent 0 34%, rgba(0, 16, 4, 0.42) 82%);
	}

	.forest-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.84) brightness(0.54) contrast(1.1);
		transform: scale(1.03);
	}

	h1 {
		position: relative;
		z-index: 3;
		display: inline-flex;
		align-items: flex-start;
		justify-content: center;
		gap: 0.08em;
		margin: 0 0 96px;
		color: #fff;
		font-family: 'Huiwen-mincho', Georgia, serif !important;
		font-size: clamp(6.6rem, 17vw, 18rem);
		font-weight: 400;
		line-height: 0.82;
		letter-spacing: 0;
		text-shadow: 0 24px 70px rgba(0, 0, 0, 0.26);
	}

	h1 em {
		margin-top: -0.04em;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.24em;
		font-style: normal;
		line-height: 1;
	}

	.listen-button {
		position: absolute;
		z-index: 4;
		top: 58vh;
		left: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		min-height: 70px;
		padding: 0 12px 0 30px;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		color: #04210a;
		font-size: clamp(0.94rem, 1.2vw, 1.1rem);
		font-weight: 800;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		cursor: pointer;
		transform: translate(-50%, -50%);
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.listen-button:hover {
		transform: translate(-50%, -52%);
		box-shadow: 0 32px 88px rgba(0, 0, 0, 0.32);
	}

	.listen-button i {
		position: relative;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: #d7ecd4;
	}

	.listen-button i::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 52%;
		width: 0;
		height: 0;
		border-top: 9px solid transparent;
		border-bottom: 9px solid transparent;
		border-left: 13px solid #002407;
		transform: translate(-42%, -50%);
	}

	.is-playing .listen-button i::before {
		left: 50%;
		width: 13px;
		height: 18px;
		border: 0;
		border-right: 4px solid #002407;
		border-left: 4px solid #002407;
		transform: translate(-50%, -50%);
	}

	.intro {
		position: absolute;
		left: 50%;
		bottom: 7vh;
		z-index: 3;
		width: min(900px, calc(100vw - 42px));
		margin: 0;
		color: rgba(255, 255, 255, 0.86);
		font-size: clamp(1rem, 1.4vw, 1.35rem);
		line-height: 1.85;
		transform: translateX(-50%);
	}

	.sound-meta {
		position: absolute;
		left: 50%;
		bottom: 3vh;
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: rgba(255, 255, 255, 0.54);
		font-size: 0.82rem;
		transform: translateX(-50%);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.36);
	}

	.is-playing .pulse {
		background: #d7ecd4;
		box-shadow: 0 0 0 7px rgba(215, 236, 212, 0.12);
		animation: pulse 1.8s ease-in-out infinite;
	}

	.bird-field {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		opacity: 0.28;
	}

	.bird-field span {
		position: absolute;
		top: 24%;
		left: -8vw;
		width: 42px;
		height: 17px;
		animation: fly 42s linear infinite;
	}

	.bird-field span::before,
	.bird-field span::after {
		content: "";
		position: absolute;
		top: 8px;
		width: 22px;
		height: 8px;
		border-top: 2px solid rgba(255, 255, 255, 0.72);
	}

	.bird-field span::before {
		right: 19px;
		border-radius: 100% 0 0;
	}

	.bird-field span::after {
		left: 19px;
		border-radius: 0 100% 0 0;
	}

	.bird-field span:nth-child(2) { top: 33%; animation-delay: -9s; transform: scale(0.72); }
	.bird-field span:nth-child(3) { top: 18%; animation-delay: -18s; transform: scale(0.54); }
	.bird-field span:nth-child(4) { top: 44%; animation-delay: -27s; transform: scale(0.48); }
	.bird-field span:nth-child(5) { top: 12%; animation-delay: -36s; transform: scale(0.38); }

	.about-layer {
		position: fixed;
		inset: 0;
		z-index: 20;
		display: block;
	}

	.about-layer[hidden] {
		display: none;
	}

	.about-backdrop {
		position: absolute;
		inset: 0;
		border: 0;
		background: rgba(0, 15, 4, 0.42);
		cursor: pointer;
		backdrop-filter: blur(8px);
	}

	.about-panel {
		position: absolute;
		top: 82px;
		right: 34px;
		width: min(410px, calc(100vw - 36px));
		padding: 30px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 8px;
		background: rgba(4, 27, 9, 0.92);
		color: #fff;
		box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
		backdrop-filter: blur(24px) saturate(140%);
		animation: about-in 0.26s ease both;
	}

	.about-close {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 34px;
		height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.75);
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
	}

	.about-kicker {
		margin: 0 0 12px;
		color: rgba(255, 255, 255, 0.48);
		font-family: var(--font-type);
		font-size: 0.76rem;
		letter-spacing: 0.14em;
	}

	.about-panel h2 {
		margin: 0 0 18px;
		color: #fff;
		font-family: 'Huiwen-mincho', serif;
		font-size: 2rem;
		font-weight: 400;
		line-height: 1.2;
		text-align: left;
	}

	.about-panel p:not(.about-kicker) {
		margin: 0 0 1em;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.98rem;
		line-height: 1.9;
	}

	.about-panel p:last-child {
		margin-bottom: 0;
	}

	@keyframes pulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.3); }
	}

	@keyframes fly {
		0% { translate: -10vw 0; }
		52% { translate: 58vw -6vh; }
		100% { translate: 120vw 2vh; }
	}

	@keyframes about-in {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media(max-width: 767px) {
		.forest-nav {
			padding: 20px;
		}

		.home-link {
			font-size: 0.88rem;
		}

		.about-button {
			min-height: 38px;
			padding: 0 14px;
		}

		.hero {
			padding-inline: 18px;
		}

		.forest-card {
			top: 18vh;
			width: 62vw;
			min-width: 230px;
		}

		h1 {
			margin-bottom: 80px;
			font-size: clamp(5.2rem, 24vw, 8.5rem);
		}

		.listen-button {
			top: 59vh;
			min-height: 58px;
			padding-left: 22px;
			gap: 12px;
			white-space: nowrap;
		}

		.listen-button i {
			width: 42px;
			height: 42px;
		}

		.intro {
			bottom: 8vh;
			font-size: 0.94rem;
			line-height: 1.75;
		}

		.sound-meta {
			bottom: 3.2vh;
		}

		.about-panel {
			top: 72px;
			right: 16px;
			padding: 24px;
		}
	}
</style>
