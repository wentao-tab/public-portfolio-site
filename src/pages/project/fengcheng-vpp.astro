---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { withBase } from "../../utils/paths";
---

<BlogPostLayout
	title="凤城全域虚拟电厂智慧驾驶舱"
	description="凤城全域虚拟电厂智慧驾驶舱项目入口"
	keywords="凤城,虚拟电厂,智慧驾驶舱,能源调度,数据可视化"
>
	<div class="post">
		<main class="project-detail">
			<section class="detail-hero">
				<a class="detail-back" href={withBase('/')} aria-label="返回首页">
					<span>←</span>
					返回首页
				</a>
				<div class="detail-kicker">ENERGY DASHBOARD</div>
				<h1 class="font-huiwen">凤城全域虚拟电厂智慧驾驶舱</h1>
				<p>
					面向全域能源调度、负荷聚合、运行态势感知和管理决策的智慧驾驶舱项目。
				</p>
			</section>

			<section class="detail-board" aria-label="项目驾驶舱预览">
				<img src={withBase('/assets/cover/cover-fengcheng-vpp.jpg')} alt="凤城全域虚拟电厂智慧驾驶舱页面效果图" loading="eager" />
			</section>

			<section class="detail-content border-top">
				<h2>项目说明</h2>
				<p>
					这里先作为项目入口保留。后续可以补充项目背景、产品架构、关键页面、数据指标、交互流程和视觉方案。
				</p>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style lang="scss">
	.project-detail {
		margin: 0 auto;
	}

	.detail-hero {
		margin: 40px auto 32px;
		text-align: center;

		h1 {
			max-width: 780px;
			margin: 18px auto 16px;
			font-size: 3.6rem;
			line-height: 1.16;
		}

		p {
			max-width: 620px;
			margin: 0 auto;
			color: var(--color-300);
			text-align: center;
		}
	}

	.detail-back {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 34px;
		margin-bottom: 14px;
		padding: 0 16px;
		border: 1px solid var(--color-700);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		color: var(--color-300);
		font-size: 0.88rem;
		line-height: 1;
		text-decoration: none;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.04);
		transition: transform 0.22s ease, color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;

		span {
			font-size: 1rem;
			transform: translateY(-1px);
		}

		&:hover {
			transform: translateY(-2px);
			border-color: var(--color-blue);
			color: var(--color-100);
			text-decoration: none;
			box-shadow: 0 16px 36px rgba(27, 72, 92, 0.1);
		}
	}

	.detail-kicker {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		padding: 0 16px;
		border: 1px solid var(--color-700);
		border-radius: 999px;
		color: var(--color-300);
		font-family: var(--font-type);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.detail-board {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: #eef8f4;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.06);

		img {
			display: block;
			width: 100%;
			height: auto;
		}
	}

	.detail-content {
		margin-top: 42px;
		padding-top: 28px;

		h2 {
			margin-bottom: 16px;
			font-size: 1.5rem;
		}

		p {
			max-width: 680px;
			color: var(--color-300);
		}
	}

	@media(max-width: 767px) {
		.detail-hero h1 {
			font-size: 2.2rem;
		}
	}
</style>
