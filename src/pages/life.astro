---
import BaseLayout from '../layouts/BaseLayout.astro';
import { personalSite2 } from '../data/personalSite2';
import { withBase } from '../utils/paths';

const { metadata, navItems, activities, categories, entries, categoryMeta } = personalSite2;
const categoryMetaJson = JSON.stringify(categoryMeta);
---

<BaseLayout
	title={metadata.title}
	description={metadata.description}
	keywords={metadata.keywords}
>
	<main class="life-page" data-life-page>
		<div class="snail-lane" aria-hidden="true">
			<div class="snail">
				<svg viewBox="0 0 60 36" role="img">
					<path class="snail-foot" d="M8 34 C3.5 34 3.5 29.4 9 28.2 C18 26.5 42 26.5 51 28.2 C56.5 29.4 56.5 34 52 34 Z" />
					<path class="snail-neck" d="M24.5 31 C23.5 25 25 22.8 30 22.8 C35 22.8 36.5 25 35.5 31 Z" />
					<path class="snail-stalk" d="M28 24 C27 19 26.8 15 26.5 11" />
					<path class="snail-stalk" d="M32 23.6 C33 18 33.4 14 33.8 9.2" />
					<circle class="snail-eye" cx="26.5" cy="10.4" r="2.4" />
					<circle class="snail-eye" cx="33.8" cy="8.8" r="2.6" />
					<circle class="snail-shell" cx="30" cy="19" r="12" />
					<path class="snail-spiral" d="M30 19 C30 16.6 33 16.6 33 19.6 C33 23.6 27 23.6 27 18.6 C27 13.2 35.6 13.2 35.6 19.6 C35.6 27 23 27 23 18.6 C23 10.2 38.6 10.2 38.6 19.6" />
				</svg>
			</div>
		</div>

		<section class="printer">
			<header class="printer-head">
				<div class="stickers" aria-hidden="true">
					<span class="sticker sticker-red">Swift</span>
					<span class="sticker sticker-blue">AI</span>
					<span class="sticker sticker-star">✳</span>
					<span class="sticker sticker-cloud">☁</span>
				</div>

				<div class="brand-line">
					<button class="life-avatar" type="button" data-panel-filter="thought" data-panel-title="关于" data-panel-desc="一些关于我、设计和读书思考的入口。" aria-label="查看关于内容">
						<img src={withBase('/assets/author.png')} alt="" />
					</button>
					<div>
						<div class="brand-name">WENTAO</div>
						<div class="brand-sub" data-life-subtitle>life receipt</div>
					</div>
					<div class="power">
						<span></span>
						<small>ON</small>
					</div>
				</div>

				<div class="control-line">
					<nav class="printer-nav" aria-label="生活页导航">
						{navItems.map((item) => (
							<button
								class:list={['printer-btn', { active: item.active }]}
								type="button"
								data-panel-filter={item.filter}
								data-panel-title={item.title}
								data-panel-desc={item.desc}
							>
								{item.label}
							</button>
						))}
					</nav>

					<div class="knobs" aria-label="页面控制">
						<button class="dial" type="button" data-life-lang aria-label="切换显示语言">
							<span class="dial-label dial-left">EN</span>
							<span class="dial-label dial-right active">中</span>
							<i></i>
						</button>
						<button class="dial" type="button" data-life-theme aria-label="切换主题">
							<span class="dial-label dial-left active">亮</span>
							<span class="dial-label dial-right">暗</span>
							<i></i>
						</button>
					</div>
				</div>

				<div class="paper-slot" aria-hidden="true"></div>
			</header>

			<section class="paper">
				<div class="paper-holes left" aria-hidden="true"></div>
				<div class="paper-holes right" aria-hidden="true"></div>

				<div class="paper-inner">
					<div class="receipt-title">
						<div>
							<p class="kicker">PRINTED LIFE</p>
							<h1 data-receipt-title>生活</h1>
							<p class="receipt-desc" data-receipt-desc>读书、工具、项目和日常观察，像一张慢慢吐出来的生活小票。</p>
							<p class="count"><span data-entry-count>{entries.length}</span> 条</p>
						</div>
						<button class="mini-print" type="button" data-random-entry>随机吐一张</button>
					</div>

					<section class="receipt-section">
						<p class="section-label">活动</p>
						<div class="chip-row">
							{activities.map((activity) => (
								<button class="chip chip-link" type="button" data-filter={activity.filter}>
									<span>{activity.icon === 'book' ? '冊' : activity.icon === 'tool' ? '⚙' : '▦'}</span>
									{activity.label}
								</button>
							))}
						</div>
					</section>

					<section class="receipt-section">
						<p class="section-label">分类</p>
						<div class="chip-row" data-filter-row>
							{categories.map((category) => (
								<button
									class:list={['chip', 'filter-chip', { active: category.value === 'all' }]}
									type="button"
									data-filter={category.value}
								>
									{category.label} ({category.count})
								</button>
							))}
						</div>
					</section>

					<section class="entry-list" data-entry-list>
						{entries.map((entry) => (
							<button
								class="entry"
								type="button"
								data-category={entry.category}
								data-entry-title={entry.title}
								data-entry-desc={entry.desc}
								data-entry-date={entry.date}
							>
								<time>{entry.date}</time>
								<h2>{entry.title}</h2>
								<p>{entry.desc}</p>
							</button>
						))}
					</section>

					<footer class="receipt-footer">
						<span>© 2026 Liang Wentao</span>
						<div>
							<button type="button" data-filter="all">All</button>
							<button type="button" data-filter="tool">Tools</button>
							<button type="button" data-filter="reading">Books</button>
						</div>
					</footer>
				</div>
			</section>
		</section>
	</main>
</BaseLayout>

<script is:inline type="application/json" id="personal-site-2-category-meta" set:html={categoryMetaJson} />

<script>
	const page = document.querySelector('[data-life-page]');
	const paper = document.querySelector('.paper');
	const chips = [...document.querySelectorAll('[data-filter]')] as HTMLButtonElement[];
	const panelButtons = [...document.querySelectorAll('[data-panel-filter]')] as HTMLButtonElement[];
	const entries = [...document.querySelectorAll('.entry')] as HTMLElement[];
	const count = document.querySelector('[data-entry-count]');
	const receiptTitle = document.querySelector('[data-receipt-title]');
	const receiptDesc = document.querySelector('[data-receipt-desc]');
	const randomButton = document.querySelector('[data-random-entry]');
	const themeButton = document.querySelector('[data-life-theme]');
	const langButton = document.querySelector('[data-life-lang]');
	const subtitle = document.querySelector('[data-life-subtitle]');
	const categoryMetaNode = document.querySelector('#personal-site-2-category-meta');
	const categoryMeta = JSON.parse(categoryMetaNode?.textContent || '{}');

	const setCount = () => {
		if (!count) return;
		count.textContent = String(entries.filter((entry) => entry.style.display !== 'none').length);
	};

	const feedPaper = (update?: () => void) => {
		page?.classList.remove('is-printing');
		if (paper instanceof HTMLElement) void paper.offsetWidth;
		update?.();
		page?.classList.add('is-printing');
		window.setTimeout(() => page?.classList.remove('is-printing'), 640);
	};

	const applyFilter = (filter = 'all', title?: string, desc?: string) => {
		feedPaper(() => {
			const meta = categoryMeta[filter] ?? categoryMeta.all;
			entries.forEach((entry) => {
				entry.style.display = filter === 'all' || entry.dataset.category === filter ? '' : 'none';
				entry.classList.remove('highlight');
			});
			chips.forEach((item) => item.classList.toggle('active', item.dataset.filter === filter));
			panelButtons.forEach((item) => item.classList.toggle('active', item.dataset.panelFilter === filter && item.dataset.panelTitle === title));
			if (receiptTitle) receiptTitle.textContent = title || meta.title;
			if (receiptDesc) receiptDesc.textContent = desc || meta.desc;
			setCount();
		});
	};

	chips.forEach((chip) => {
		chip.addEventListener('click', () => applyFilter(chip.dataset.filter ?? 'all'));
	});

	panelButtons.forEach((button) => {
		button.addEventListener('click', () => {
			applyFilter(
				button.dataset.panelFilter ?? 'all',
				button.dataset.panelTitle,
				button.dataset.panelDesc,
			);
		});
	});

	entries.forEach((entry) => {
		entry.addEventListener('click', () => {
			feedPaper(() => {
				entries.forEach((item) => item.classList.remove('highlight'));
				entry.classList.add('highlight');
				if (receiptTitle) receiptTitle.textContent = entry.dataset.entryTitle || '';
				if (receiptDesc) {
					const date = entry.dataset.entryDate ? `${entry.dataset.entryDate} · ` : '';
					receiptDesc.textContent = `${date}${entry.dataset.entryDesc || ''}`;
				}
			});
		});
	});

	randomButton?.addEventListener('click', () => {
		const visible = entries.filter((entry) => entry.style.display !== 'none');
		const target = visible[Math.floor(Math.random() * visible.length)];
		if (!target) return;
		feedPaper(() => {
			target.classList.add('highlight');
			if (receiptTitle) receiptTitle.textContent = target.dataset.entryTitle || '';
			if (receiptDesc) {
				const date = target.dataset.entryDate ? `${target.dataset.entryDate} · ` : '';
				receiptDesc.textContent = `${date}${target.dataset.entryDesc || ''}`;
			}
			setTimeout(() => target.classList.remove('highlight'), 1200);
		});
	});

	themeButton?.addEventListener('click', () => {
		document.documentElement.classList.toggle('theme-dark');
		themeButton.classList.toggle('active');
	});

	langButton?.addEventListener('click', () => {
		langButton.classList.toggle('active');
		if (subtitle) {
			subtitle.textContent = langButton.classList.contains('active') ? 'life printer' : 'life receipt';
		}
	});
</script>

<style lang="scss">
	:global(body > div > nav),
	:global(body > div > footer),
	:global(.train-1),
	:global(.effects) {
		display: none !important;
	}

	:global(.train-1),
	:global(.effects) {
		pointer-events: none !important;
	}

	:global(body) {
		background: #dfe0d7;
	}

	.life-page {
		--life-bg: #dfe0d7;
		--printer: #efeadf;
		--printer-dark: #d9d2c4;
		--paper: #fffdf5;
		--ink: #35322b;
		--muted: rgba(53, 50, 43, 0.56);
		--faint: rgba(53, 50, 43, 0.09);
		--accent: #b37b45;
		--button: #d9d0bf;
		min-height: 100vh;
		padding: 38px 16px 68px;
		background:
			linear-gradient(rgba(80, 82, 70, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(80, 82, 70, 0.06) 1px, transparent 1px),
			var(--life-bg);
		background-size: 48px 48px;
		color: var(--ink);
		font-family: var(--font-body);
	}

	:global(.theme-dark) .life-page {
		--life-bg: #181a17;
		--printer: #282821;
		--printer-dark: #171713;
		--paper: #202018;
		--ink: #eee8d6;
		--muted: rgba(238, 232, 214, 0.58);
		--faint: rgba(238, 232, 214, 0.1);
		--button: #39372d;
		background-color: var(--life-bg);
	}

	.snail-lane {
		position: fixed;
		top: 10px;
		left: 50%;
		z-index: 3;
		width: min(760px, calc(100vw - 32px));
		height: 48px;
		overflow: hidden;
		pointer-events: none;
		transform: translateX(-50%);
	}

	.snail {
		position: absolute;
		top: 0;
		left: 86px;
		width: 46px;
		animation: snail-idle 4.8s ease-in-out infinite;
	}

	.snail svg {
		display: block;
		width: 100%;
		filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.1));
	}

	.snail-foot,
	.snail-neck {
		fill: #c7b98c;
	}

	.snail-stalk,
	.snail-spiral {
		fill: none;
		stroke: #7c6a43;
		stroke-linecap: round;
		stroke-width: 1.8;
	}

	.snail-eye {
		fill: #f4e8bd;
		stroke: #7c6a43;
		stroke-width: 1;
	}

	.snail-shell {
		fill: #d9a14b;
		stroke: #8f6c38;
		stroke-width: 1.5;
	}

	@keyframes snail-idle {
		0%,
		100% {
			transform: translate3d(0, 0, 0) rotate(-1deg);
		}

		45% {
			transform: translate3d(10px, -2px, 0) rotate(1deg);
		}

		70% {
			transform: translate3d(5px, 1px, 0) rotate(0deg);
		}
	}

	.printer {
		position: relative;
		z-index: 2;
		max-width: 760px;
		margin: 0 auto;
	}

	.printer-head {
		position: relative;
		z-index: 4;
		overflow: hidden;
		border-radius: 36px 36px 4px 4px;
		background: linear-gradient(180deg, #f8f2e8, var(--printer));
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);
	}

	:global(.theme-dark) .printer-head {
		background: linear-gradient(180deg, #323229, var(--printer));
	}

	.stickers {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		opacity: 0.72;
	}

	.sticker {
		position: absolute;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 11px;
		background: #fff;
		box-shadow: 0 5px 12px rgba(0, 0, 0, 0.12);
		color: #4b6aa8;
		font-family: var(--font-type);
		font-size: 0.62rem;
		font-weight: 700;
		transform: rotate(-8deg);
	}

	.sticker-red {
		left: 22px;
		top: 12px;
		background: #ef5b3d;
		color: #fff;
		transform: rotate(-8deg) scale(0.82);
	}

	.sticker-blue {
		left: 258px;
		top: 64px;
		background: #4d7edb;
		color: #fff;
		transform: rotate(-9deg) scale(0.9);
	}

	.sticker-star {
		left: 50%;
		top: 24px;
		color: #d95c4b;
		font-size: 1.6rem;
		box-shadow: none;
		background: transparent;
	}

	.sticker-cloud {
		right: 210px;
		top: 30px;
		color: #f0822d;
		box-shadow: none;
		background: transparent;
		font-size: 1.5rem;
	}

	.brand-line {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 36px 38px 22px;
	}

	.life-avatar {
		display: block;
		width: 46px;
		height: 46px;
		padding: 5px;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.08);
		cursor: pointer;
	}

	.life-avatar img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
	}

	.brand-name {
		font-family: var(--font-type);
		font-size: 1rem;
		letter-spacing: 0.24em;
	}

	.brand-sub {
		margin-top: 3px;
		color: var(--muted);
		font-family: var(--font-type);
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.power {
		margin-left: auto;
		display: grid;
		justify-items: center;
		gap: 4px;
		font-family: var(--font-type);
		font-size: 0.56rem;
		color: var(--muted);
	}

	.power span {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: #28c36f;
		box-shadow: 0 0 14px rgba(40, 195, 111, 0.7);
	}

	.control-line {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 6px 38px 30px;
	}

	.printer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.printer-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 82px;
		min-height: 46px;
		padding: 0 18px;
		border: 1px solid rgba(60, 50, 36, 0.18);
		border-radius: 8px;
		background: linear-gradient(180deg, #eee8dc, var(--button));
		color: var(--ink);
		cursor: pointer;
		box-shadow:
			0 6px 0 rgba(102, 92, 74, 0.2),
			0 8px 14px rgba(0, 0, 0, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.55);
		font-size: 0.96rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.1s ease;
	}

	.printer-btn:hover,
	.printer-btn.active {
		transform: translateY(2px);
		box-shadow:
			0 3px 0 rgba(102, 92, 74, 0.22),
			0 5px 9px rgba(0, 0, 0, 0.09),
			inset 0 1px 0 rgba(255, 255, 255, 0.35);
		text-decoration: none;
	}

	.knobs {
		display: flex;
		gap: 22px;
	}

	.dial {
		position: relative;
		width: 42px;
		height: 42px;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.dial::before {
		content: "";
		position: absolute;
		inset: 8px;
		border-radius: 50%;
		background: #e7decf;
		box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.16), 0 2px 5px rgba(0, 0, 0, 0.08);
	}

	.dial i {
		position: absolute;
		inset: 12px;
		border-radius: 50%;
		background: linear-gradient(135deg, #fff8ec, #d5c7b3);
		transition: transform 0.25s ease;
	}

	.dial i::after {
		content: "";
		position: absolute;
		top: 3px;
		left: 50%;
		width: 2px;
		height: 8px;
		border-radius: 2px;
		background: var(--accent);
		transform: translateX(-50%);
	}

	.dial.active i {
		transform: rotate(105deg);
	}

	.dial-label {
		position: absolute;
		top: -6px;
		color: var(--muted);
		font-family: var(--font-type);
		font-size: 0.55rem;
	}

	.dial-left {
		left: -6px;
	}

	.dial-right {
		right: -6px;
	}

	.dial-label.active {
		color: var(--accent);
	}

	.paper-slot {
		position: relative;
		height: 20px;
		background: var(--printer-dark);
		box-shadow: inset 0 3px 7px rgba(0, 0, 0, 0.15);
	}

	.paper-slot::after {
		content: "";
		position: absolute;
		left: 34px;
		right: 34px;
		top: 7px;
		height: 6px;
		border-radius: 2px;
		background: rgba(0, 0, 0, 0.58);
	}

	.paper {
		position: relative;
		z-index: 3;
		width: calc(100% - 78px);
		margin: -8px auto 0;
		background:
			radial-gradient(circle, rgba(70, 65, 50, 0.08) 0 1px, transparent 1px),
			var(--paper);
		background-size: 8px 8px;
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);
		clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), 98% 100%, 96% calc(100% - 8px), 94% 100%, 92% calc(100% - 8px), 90% 100%, 88% calc(100% - 8px), 86% 100%, 84% calc(100% - 8px), 82% 100%, 80% calc(100% - 8px), 78% 100%, 76% calc(100% - 8px), 74% 100%, 72% calc(100% - 8px), 70% 100%, 68% calc(100% - 8px), 66% 100%, 64% calc(100% - 8px), 62% 100%, 60% calc(100% - 8px), 58% 100%, 56% calc(100% - 8px), 54% 100%, 52% calc(100% - 8px), 50% 100%, 48% calc(100% - 8px), 46% 100%, 44% calc(100% - 8px), 42% 100%, 40% calc(100% - 8px), 38% 100%, 36% calc(100% - 8px), 34% 100%, 32% calc(100% - 8px), 30% 100%, 28% calc(100% - 8px), 26% 100%, 24% calc(100% - 8px), 22% 100%, 20% calc(100% - 8px), 18% 100%, 16% calc(100% - 8px), 14% 100%, 12% calc(100% - 8px), 10% 100%, 8% calc(100% - 8px), 6% 100%, 4% calc(100% - 8px), 2% 100%, 0 calc(100% - 8px));
		transform-origin: top center;
		will-change: transform, filter;
	}

	.paper::before {
		content: "";
		position: absolute;
		top: 0;
		left: 18px;
		right: 18px;
		z-index: 2;
		height: 26px;
		background: linear-gradient(180deg, rgba(255, 253, 245, 0.98), rgba(255, 253, 245, 0));
		opacity: 0;
		pointer-events: none;
	}

	.paper-inner {
		position: relative;
		padding: 44px 44px 74px;
		will-change: opacity, transform, filter;
	}

	.paper-holes {
		position: absolute;
		top: 18px;
		bottom: 28px;
		width: 16px;
		background-image: radial-gradient(circle, transparent 0 3px, rgba(53, 50, 43, 0.1) 3.4px, transparent 4px);
		background-size: 16px 28px;
		opacity: 0.72;
	}

	.paper-holes.left {
		left: 4px;
	}

	.paper-holes.right {
		right: 4px;
	}

	.receipt-title {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 34px;
	}

	.kicker,
	.section-label,
	.count,
	.entry time,
	.receipt-footer {
		font-family: var(--font-type);
	}

	.kicker {
		margin: 0 0 10px;
