---
import ThemeToggle from './ThemeToggle.astro';
import { nav } from '../data/content';
import { withBase } from '../utils/paths';

const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();
---

<nav class="site-nav" aria-label="主导航">
	<div class="container nav-wrapper">
		<a href={withBase('/')} class="site-brand" aria-label="返回文韬个人首页">
			<span class="site-brand__name">WENTAO</span>
			<span class="site-brand__meta">PERSONAL INDEX / {currentYear}</span>
		</a>

		<div class="site-nav__actions">
			<ul class="site-nav__links">
				{nav.items?.map(item => (
					<li>
						<a
							aria-current={currentPath === item.href ? 'page' : undefined}
							class:list={[
								'site-nav__link',
								{
									'is-active': item.href === withBase('/')
										? currentPath === item.href
										: currentPath.startsWith(item.href),
								},
							]}
							href={item.href}
							target={item.target || '_self'}
						>
							{item.label}
						</a>
					</li>
				))}
				<li><a class="site-nav__link" href="https://github.com/wentao-tab" target="_blank" rel="noreferrer">GitHub ↗</a></li>
			</ul>
			<div class="site-nav__theme"><ThemeToggle /></div>
		</div>
	</div>
</nav>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 9999;
		border-bottom: 1px solid var(--color-700);
		background: rgba(var(--color-999-rgb), 0.92);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
	}

	.nav-wrapper,
	.site-nav__actions,
	.site-nav__links,
	.site-brand {
		display: flex;
		align-items: center;
	}

	.nav-wrapper {
		min-height: 4.5rem;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-brand {
		gap: 0.8rem;
		color: var(--color-100);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-brand__name {
		font-family: 'Courier New', monospace;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.site-brand__meta {
		padding-left: 0.8rem;
		border-left: 1px solid var(--color-600);
		color: var(--color-400);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
	}

	.site-nav__actions {
		gap: 1.1rem;
	}

	.site-nav__links {
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__link {
		color: var(--color-400);
		font-family: var(--font-brand);
		font-size: 0.86rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.site-nav__link:hover,
	.site-nav__link:focus-visible,
	.site-nav__link.is-active {
		color: var(--color-100);
	}

	.site-nav__theme {
		display: flex;
		align-items: center;
	}

	:global(.site-nav theme-toggle button) {
		position: relative;
		width: 2.1rem;
		height: 2.1rem;
		border: 1px solid var(--color-600);
		border-radius: 0.35rem;
		background: transparent;
		box-shadow: none;
	}

	:global(.site-nav theme-toggle .icon) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0.5rem;
		color: var(--color-100) !important;
	}

	:global(.site-nav theme-toggle .icon.light::before) {
		display: none;
	}

	:global(html:not(.theme-dark) .site-nav theme-toggle .icon.dark),
	:global(.theme-dark .site-nav theme-toggle .icon.light) {
		display: none;
	}

	:global(.site-nav theme-toggle button:hover) {
		border-color: var(--color-400);
		background: var(--color-800);
	}

	@media (max-width: 42rem) {
		.nav-wrapper { min-height: 4rem; gap: 0.75rem; }
		.site-brand { gap: 0.55rem; }
		.site-brand__name { font-size: 0.78rem; }
		.site-brand__meta { padding-left: 0.55rem; font-size: 0.58rem; letter-spacing: 0.08em; }
		.site-nav__links { gap: 0.7rem; }
		.site-nav__links li:last-child { display: none; }
		.site-nav__link { font-size: 0.78rem; }
		.site-nav__actions { gap: 0.6rem; }
	}
</style>
